<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DataBindingDemos"
             x:Class="DataBindingDemos.MonkeysPage"
             Title="Monkeys"
             x:DataType="local:MonkeysViewModel">
    <Grid Margin="20">
        <CollectionView ItemsSource="{Binding Monkeys}"
                        SelectionMode="Single"
                        SelectionChanged="OnCollectionViewSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Monkey">
                    <Grid Padding="10"
                          RowDefinitions="Auto,Auto,1"
                          ColumnDefinitions="Auto,*">
                            <Image Grid.RowSpan="2" 
                                   Source="{Binding ImageUrl, TargetNullValue={StaticResource fallbackImageUrl}}" 
                                   Aspect="AspectFill" 
                                   HeightRequest="60" 
                                   WidthRequest="60" />
                            <Label Grid.Column="1" 
                                   Text="{Binding Name}" 
                                   Style="{DynamicResource TitleStyle}" />
                            <Label Grid.Row="1" 
                                   Grid.Column="1" 
                                   Text="{Binding Location, TargetNullValue={StaticResource locationUnknown}}" 
                                   VerticalOptions="End" 
                                   Style="{DynamicResource SubtitleTextStyle}" />
                        <BoxView Grid.Row="2"
                                 Grid.ColumnSpan="2"
                                 Color="#E0E0E0"
                                 HeightRequest="1" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
