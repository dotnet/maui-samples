<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DataBindingDemos.AlternativeCodeBindingPage"
             Title="Code binding with a source">
    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Basic bindings" Style="{StaticResource Eyebrow}" />
                <Label Text="Code binding with a source" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="SetBinding passes the Slider as the source, so no BindingContext is needed. The Label's Scale follows the Slider, from -2 to 2, starting at 1. Drag the slider." Style="{StaticResource Lead}" />
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <Grid RowDefinitions="200,Auto">
                    <!-- The binding is set in AlternativeCodeBindingPage.xaml.cs -->
                    <Label x:Name="label"
                           Text="TEXT"
                           FontSize="40"
                           Style="{StaticResource DemoText}" />

                    <Slider x:Name="slider"
                            Grid.Row="1"
                            Minimum="-2"
                            Maximum="2"
                            Value="1" />
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
