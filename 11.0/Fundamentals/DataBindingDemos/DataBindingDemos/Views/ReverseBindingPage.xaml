<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DataBindingDemos.ReverseBindingPage"
             Title="Reverse binding">
    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Binding mode" Style="{StaticResource Eyebrow}" />
                <Label Text="Reverse binding" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="The binding is set on the Slider, the target, with the Label's Opacity as the source. Because Slider.Value binds TwoWay by default, the Slider starts at 1 and then sets the Opacity. Drag the slider." Style="{StaticResource Lead}" />
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <Label x:Name="label"
                           Text="TEXT"
                           FontSize="80"
                           Style="{StaticResource DemoText}" />

                    <Slider x:Name="slider"
                            x:DataType="Label"
                            Value="{Binding Source={x:Reference label},
                                            Path=Opacity}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
