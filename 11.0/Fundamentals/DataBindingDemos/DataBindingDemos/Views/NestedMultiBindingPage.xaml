<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DataBindingDemos"
             x:Class="DataBindingDemos.NestedMultiBindingPage"
             Title="Nested multi-bindings"
             x:DataType="local:GroupViewModel">
    <ContentPage.BindingContext>
        <local:GroupViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <local:AllTrueMultiConverter x:Key="AllTrueConverter" />
        <local:AnyTrueMultiConverter x:Key="AnyTrueConverter" />
        <local:InverterConverter x:Key="InverterConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Multi-bindings" Style="{StaticResource Eyebrow}" />
                <Label Text="Nested multi-bindings" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="The outer MultiBinding uses AnyTrueMultiConverter on two values: the inner MultiBinding from the previous demo, and IsMonarch. So a monarch can always drive." Style="{StaticResource Lead}" />
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="*,96"
                      RowSpacing="4">
                    <Label Text="Employee"
                           Style="{StaticResource SectionHeader}"
                           VerticalTextAlignment="Center" />
                    <Label Grid.Column="1"
                           Text="Can drive?"
                           Style="{StaticResource SectionHeader}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                    <Label Grid.Row="1"
                           Text="{Binding Employee1.FullName}"
                           VerticalTextAlignment="Center" />
                    <CheckBox Grid.Row="1"
                              Grid.Column="1"
                              IsEnabled="False"
                              HorizontalOptions="Center">
                        <CheckBox.IsChecked>
                            <MultiBinding Converter="{StaticResource AnyTrueConverter}"
                                          FallbackValue="false">
                                <MultiBinding Converter="{StaticResource AllTrueConverter}"
                                              FallbackValue="false">
                                    <Binding Path="Employee1.IsOver16" />
                                    <Binding Path="Employee1.HasPassedTest" />
                                    <Binding Path="Employee1.IsSuspended" Converter="{StaticResource InverterConverter}" />
                                </MultiBinding>
                                <Binding Path="Employee1.IsMonarch" />
                            </MultiBinding>
                        </CheckBox.IsChecked>
                    </CheckBox>
                    <Label Grid.Row="2"
                           Text="{Binding Employee2.FullName}"
                           VerticalTextAlignment="Center" />
                    <CheckBox Grid.Row="2"
                              Grid.Column="1"
                              IsEnabled="False"
                              HorizontalOptions="Center">
                        <CheckBox.IsChecked>
                            <MultiBinding Converter="{StaticResource AnyTrueConverter}"
                                          FallbackValue="false">
                                <MultiBinding Converter="{StaticResource AllTrueConverter}"
                                              FallbackValue="false">
                                    <Binding Path="Employee2.IsOver16" />
                                    <Binding Path="Employee2.HasPassedTest" />
                                    <Binding Path="Employee2.IsSuspended" Converter="{StaticResource InverterConverter}" />
                                </MultiBinding>
                                <Binding Path="Employee2.IsMonarch" />
                            </MultiBinding>
                        </CheckBox.IsChecked>
                    </CheckBox>
                    <Label Grid.Row="3"
                           Text="{Binding Employee3.FullName}"
                           VerticalTextAlignment="Center" />
                    <CheckBox Grid.Row="3"
                              Grid.Column="1"
                              IsEnabled="False"
                              HorizontalOptions="Center">
                        <CheckBox.IsChecked>
                            <MultiBinding Converter="{StaticResource AnyTrueConverter}"
                                          FallbackValue="false">
                                <MultiBinding Converter="{StaticResource AllTrueConverter}"
                                              FallbackValue="false">
                                    <Binding Path="Employee3.IsOver16" />
                                    <Binding Path="Employee3.HasPassedTest" />
                                    <Binding Path="Employee3.IsSuspended" Converter="{StaticResource InverterConverter}" />
                                </MultiBinding>
                                <Binding Path="Employee3.IsMonarch" />
                            </MultiBinding>
                        </CheckBox.IsChecked>
                    </CheckBox>
                    <Label Grid.Row="4"
                           Text="{Binding Employee4.FullName}"
                           VerticalTextAlignment="Center" />
                    <CheckBox Grid.Row="4"
                              Grid.Column="1"
                              IsEnabled="False"
                              HorizontalOptions="Center">
                        <CheckBox.IsChecked>
                            <MultiBinding Converter="{StaticResource AnyTrueConverter}"
                                          FallbackValue="false">
                                <MultiBinding Converter="{StaticResource AllTrueConverter}"
                                              FallbackValue="false">
                                    <Binding Path="Employee4.IsOver16" />
                                    <Binding Path="Employee4.HasPassedTest" />
                                    <Binding Path="Employee4.IsSuspended" Converter="{StaticResource InverterConverter}" />
                                </MultiBinding>
                                <Binding Path="Employee4.IsMonarch" />
                            </MultiBinding>
                        </CheckBox.IsChecked>
                    </CheckBox>
                    <Label Grid.Row="5"
                           Text="{Binding Employee5.FullName}"
                           VerticalTextAlignment="Center" />
                    <CheckBox Grid.Row="5"
                              Grid.Column="1"
                              IsEnabled="False"
                              HorizontalOptions="Center">
                        <CheckBox.IsChecked>
                            <MultiBinding Converter="{StaticResource AnyTrueConverter}"
                                          FallbackValue="false">
                                <MultiBinding Converter="{StaticResource AllTrueConverter}"
                                              FallbackValue="false">
                                    <Binding Path="Employee5.IsOver16" />
                                    <Binding Path="Employee5.HasPassedTest" />
                                    <Binding Path="Employee5.IsSuspended" Converter="{StaticResource InverterConverter}" />
                                </MultiBinding>
                                <Binding Path="Employee5.IsMonarch" />
                            </MultiBinding>
                        </CheckBox.IsChecked>
                    </CheckBox>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
