<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:globe="clr-namespace:System.Globalization;assembly=netstandard"
             x:Class="DataBindingDemos.PathVariationsPage"
             Title="Path variations">
    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Binding path" Style="{StaticResource Eyebrow}" />
                <Label Text="Path variations" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="A Path can reach sub-properties, such as Time.TotalSeconds, collection members, such as Children.Count, and indexed items, such as DayNames[3]. Select a time." Style="{StaticResource Lead}" />
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <!-- The third Label counts the children of this layout -->
                <VerticalStackLayout x:Name="stackLayout"
                                     Spacing="16">
                    <Label Text="Select a time:"
                           Style="{StaticResource Caption}" />

                    <TimePicker x:Name="timePicker" />

                    <Label x:Name="label"
                           Style="{StaticResource Value}"
                           Text="{Binding x:DataType='TimePicker',
                                          Source={x:Reference timePicker},
                                          Path=Time.TotalSeconds,
                                          StringFormat='{0} total seconds'}" />

                    <Label Style="{StaticResource Value}"
                           Text="{Binding x:DataType='VerticalStackLayout',
                                          Source={x:Reference stackLayout},
                                          Path=Children.Count,
                                          StringFormat='There are {0} children in this VerticalStackLayout'}" />

                    <Label Style="{StaticResource Value}"
                           Text="{Binding x:DataType='globe:CultureInfo',
                                          Source={x:Static globe:CultureInfo.CurrentCulture},
                                          Path=DateTimeFormat.DayNames[3],
                                          StringFormat='The middle day of the week is {0}'}" />

                    <Label Style="{StaticResource Value}">
                        <Label.Text>
                            <Binding x:DataType="globe:CultureInfo"
                                     Path="DateTimeFormat.DayNames[3]"
                                     StringFormat="The middle day of the week in French is {0}">
                                <Binding.Source>
                                    <globe:CultureInfo>
                                        <x:Arguments>
                                            <x:String>fr-FR</x:String>
                                        </x:Arguments>
                                    </globe:CultureInfo>
                                </Binding.Source>
                            </Binding>
                        </Label.Text>
                    </Label>

                    <Label Style="{StaticResource Value}"
                           Text="{Binding x:DataType='Label',
                                          Source={x:Reference label},
                                          Path=Text.Length,
                                          StringFormat='The second Label has {0} characters'}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
