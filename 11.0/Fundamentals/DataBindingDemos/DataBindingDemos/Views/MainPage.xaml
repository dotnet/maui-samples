<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DataBindingDemos"
             xmlns:models="clr-namespace:DataBindingDemos.Models"
             x:Class="DataBindingDemos.MainPage"
             x:Name="page"
             x:DataType="local:MainPage"
             Title="Data binding"
             NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="Container">

    <!-- The hero and filters sit outside the CollectionView, so filtering the
         list never re-creates the SearchBar while you type. -->
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Declared first (but shown in the last row) so that on Android the list,
             not the SearchBar, gets the initial focus. Otherwise the keyboard opens. -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Groups}"
                        IsGrouped="True"
                        SelectionMode="None">

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:DemoGroup">
                    <Grid Padding="24,20,24,8"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10">
                        <Ellipse Fill="{Binding Category.AccentBrush}"
                                 WidthRequest="8"
                                 HeightRequest="8"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding Name}"
                               Style="{StaticResource SectionHeader}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Grid.Column="2"
                               Text="{Binding Count}"
                               Style="{StaticResource Caption}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DemoInfo">
                    <Grid Padding="20,5">
                        <Border Style="{StaticResource Card}"
                                SemanticProperties.Description="{Binding Title}"
                                SemanticProperties.Hint="{Binding Description}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand, Source={x:Reference page}, x:DataType=local:MainPage}"
                                                      CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="14">
                                <Border Style="{StaticResource IconTile}"
                                        Background="{Binding Category.AccentBrush}">
                                    <Label Text="{Binding Glyph}"
                                           Style="{StaticResource Icon}"
                                           FontSize="22"
                                           TextColor="White" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           Style="{StaticResource Headline}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Description}"
                                           Style="{StaticResource Caption}"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{x:Static local:MaterialIcons.ChevronRight}"
                                       Style="{StaticResource Icon}"
                                       FontSize="22"
                                       TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,48"
                                     Spacing="8">
                    <Label Text="{x:Static local:MaterialIcons.SearchOff}"
                           Style="{StaticResource Icon}"
                           FontSize="40"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                    <Label Text="No demos found"
                           Style="{StaticResource Headline}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Try a different name or category."
                           Style="{StaticResource Caption}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="24"
                         Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <Grid x:Name="hero"
              Padding="20,12,20,0">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="{StaticResource HeroStart}" Offset="0" />
                        <GradientStop Color="{StaticResource HeroMiddle}" Offset="0.55" />
                        <GradientStop Color="{StaticResource HeroEnd}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Decorative circles -->
                    <Ellipse Fill="#1AFFFFFF"
                             WidthRequest="240"
                             HeightRequest="240"
                             HorizontalOptions="End"
                             VerticalOptions="Start"
                             Margin="0,-110,-80,0" />
                    <Ellipse Fill="#12FFFFFF"
                             WidthRequest="160"
                             HeightRequest="160"
                             HorizontalOptions="Start"
                             VerticalOptions="End"
                             Margin="-60,0,0,-90" />

                    <Grid Padding="22,16,18,18"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          RowSpacing="4">
                        <Border Background="#26FFFFFF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,4"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
                            <Label Text=".NET MAUI"
                                   FontFamily="InterSemiBold"
                                   FontSize="12"
                                   CharacterSpacing="0.6"
                                   TextColor="White" />
                        </Border>
                        <Image Grid.Column="1"
                               Source="dotnet_bot.png"
                               HeightRequest="64"
                               Aspect="AspectFit"
                               SemanticProperties.Description="The .NET bots riding a rocket" />
                        <Label Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Data binding"
                               Style="{StaticResource Title1}"
                               TextColor="White"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Text="{Binding DemoCount, StringFormat='{0} demos of bindings, converters, commands, and more.'}"
                               Style="{StaticResource Body}"
                               TextColor="#E6FFFFFF" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <VerticalStackLayout Grid.Row="1"
                             Padding="20,14,20,0"
                             Spacing="10">
            <SearchBar Placeholder="Search demos"
                       TextChanged="OnSearchTextChanged" />

            <CollectionView ItemsSource="{Binding FilterOptions}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedFilter}"
                            SelectionChanged="OnFilterSelectionChanged"
                            HeightRequest="{StaticResource ChipHeight}"
                            Margin="-20,0"
                            HorizontalScrollBarVisibility="Never">
                <!-- Spacers keep the first and last chip aligned with the page margins. -->
                <CollectionView.Header>
                    <BoxView WidthRequest="20" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <BoxView WidthRequest="20" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DemoCategory">
                        <Border Style="{StaticResource Chip}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                            <Setter TargetName="chipLabel" Property="Label.TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label x:Name="chipLabel"
                                   Text="{Binding Name}"
                                   Style="{StaticResource ChipLabel}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
