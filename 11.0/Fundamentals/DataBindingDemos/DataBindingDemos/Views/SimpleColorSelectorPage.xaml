<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DataBindingDemos"
             x:Class="DataBindingDemos.SimpleColorSelectorPage"
             Title="Simple color selector"
             x:DataType="local:HslColorViewModel">
    <ContentPage.BindingContext>
        <local:HslColorViewModel Color="MediumTurquoise" />
    </ContentPage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Binding mode" Style="{StaticResource Eyebrow}" />
                <Label Text="Simple color selector" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="The page's BindingContext is an HslColorViewModel. The Slider bindings are TwoWay, so the sliders start at the view model's values and then update it. Drag a slider." Style="{StaticResource Lead}" />
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="12">
                    <BoxView Color="{Binding Color}"
                             Style="{StaticResource ColorPreview}" />
                    <Label Text="{Binding Name}"
                           Style="{StaticResource Title2}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Hue" Style="{StaticResource Caption}" />
                    <Slider Value="{Binding Hue}" />
                    <Label Text="Saturation" Style="{StaticResource Caption}" />
                    <Slider Value="{Binding Saturation}" />
                    <Label Text="Luminosity" Style="{StaticResource Caption}" />
                    <Slider Value="{Binding Luminosity}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
