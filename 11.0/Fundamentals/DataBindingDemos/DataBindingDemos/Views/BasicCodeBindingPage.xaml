<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DataBindingDemos.BasicCodeBindingPage"
             Title="Code binding">
    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Basic bindings" Style="{StaticResource Eyebrow}" />
                <Label Text="Code binding" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="The code-behind sets the Label's BindingContext to the Slider, then calls SetBinding to bind Rotation to the Slider's Value. Drag the slider." Style="{StaticResource Lead}" />
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <Grid RowDefinitions="260,Auto">
                    <!-- The binding is set in BasicCodeBindingPage.xaml.cs -->
                    <Label x:Name="label"
                           Text="TEXT"
                           FontSize="80"
                           Style="{StaticResource DemoText}" />

                    <Slider x:Name="slider"
                            Grid.Row="1"
                            Maximum="360" />
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
