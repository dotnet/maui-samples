<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Implicit styles -->

    <Style TargetType="ContentPage"
           ApplyToDerivedTypes="True">
        <Setter Property="Background"
                Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily"
                Value="NunitoRegular" />
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily"
                Value="NunitoExtraBold" />
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="TextColor"
                Value="White" />
        <Setter Property="Background"
                Value="{StaticResource AboutLight}" />
        <Setter Property="CornerRadius"
                Value="16" />
        <Setter Property="Padding"
                Value="20,14" />
        <Setter Property="MinimumHeightRequest"
                Value="48" />
    </Style>

    <!-- Text -->

    <Style x:Key="DisplayTitle"
           TargetType="Label">
        <Setter Property="FontFamily"
                Value="NunitoExtraBold" />
        <Setter Property="FontSize"
                Value="32" />
    </Style>

    <Style x:Key="SectionHeader"
           TargetType="Label">
        <Setter Property="FontFamily"
                Value="NunitoExtraBold" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="CharacterSpacing"
                Value="1.5" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="Body"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="LineHeight"
                Value="1.4" />
    </Style>

    <Style x:Key="Secondary"
           TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="ListIntro"
           TargetType="Label"
           BasedOn="{StaticResource Secondary}">
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="Margin"
                Value="20,20,20,8" />
    </Style>

    <Style x:Key="ItemTitle"
           TargetType="Label">
        <Setter Property="FontFamily"
                Value="NunitoExtraBold" />
        <Setter Property="FontSize"
                Value="17" />
    </Style>

    <Style x:Key="ItemSubtitle"
           TargetType="Label"
           BasedOn="{StaticResource Secondary}">
        <Setter Property="FontSize"
                Value="14" />
    </Style>

    <Style x:Key="Chevron"
           TargetType="Label"
           BasedOn="{StaticResource Secondary}">
        <Setter Property="Text"
                Value="›" />
        <Setter Property="AutomationProperties.IsInAccessibleTree"
                Value="False" />
        <Setter Property="FontSize"
                Value="28" />
        <Setter Property="VerticalOptions"
                Value="Center" />
    </Style>

    <!-- Room to scroll the last item clear of the floating iOS tab bar -->
    <Style x:Key="ListFooter"
           TargetType="ContentView">
        <Setter Property="HeightRequest"
                Value="{OnPlatform iOS=100, Default=24}" />
    </Style>

    <!-- Surfaces -->

    <Style x:Key="Card"
           TargetType="Border">
        <Setter Property="Background"
                Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 22" />
        <Setter Property="Padding"
                Value="12" />
    </Style>

    <Style x:Key="EmojiTile"
           TargetType="Border">
        <Setter Property="Background"
                Value="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}" />
        <Setter Property="StrokeThickness"
                Value="0" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 18" />
        <Setter Property="WidthRequest"
                Value="60" />
        <Setter Property="HeightRequest"
                Value="60" />
    </Style>

    <Style x:Key="HeroTile"
           TargetType="Border"
           BasedOn="{StaticResource EmojiTile}">
        <Setter Property="StrokeShape"
                Value="RoundRectangle 32" />
        <Setter Property="WidthRequest"
                Value="-1" />
        <Setter Property="HeightRequest"
                Value="208" />
    </Style>

    <Style x:Key="Pill"
           TargetType="Border">
        <Setter Property="Background"
                Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 18" />
        <Setter Property="Padding"
                Value="10,6,14,6" />
        <Setter Property="HorizontalOptions"
                Value="Start" />
    </Style>

</ResourceDictionary>
