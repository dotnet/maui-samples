<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Each animal family has its own color. Shell styles in AppShell.xaml use these for
         the navigation bar (Light, or Deep in dark theme) and the selected tab (Light, or Bright in dark theme). -->
    <Color x:Key="DomesticLight">#B53D20</Color>
    <Color x:Key="DomesticDeep">#A23B22</Color>
    <Color x:Key="DomesticBright">#FF9B7A</Color>

    <Color x:Key="MonkeysLight">#2B7A4B</Color>
    <Color x:Key="MonkeysDeep">#1F6A42</Color>
    <Color x:Key="MonkeysBright">#6FD49A</Color>

    <Color x:Key="ElephantsLight">#4E5F9E</Color>
    <Color x:Key="ElephantsDeep">#3F4F86</Color>
    <Color x:Key="ElephantsBright">#A9B6EC</Color>

    <Color x:Key="BearsLight">#8A5A36</Color>
    <Color x:Key="BearsDeep">#6B4630</Color>
    <Color x:Key="BearsBright">#D9A57E</Color>

    <Color x:Key="AboutLight">#512BD4</Color>
    <Color x:Key="AboutDeep">#3E1FA8</Color>
    <Color x:Key="AboutBright">#B9A6FF</Color>
    <Color x:Key="AboutGlowLight">#8B6CF5</Color>
    <Color x:Key="AboutGlowDark">#5A3BC4</Color>

    <!-- Warm neutrals, in Light and Dark pairs. -->
    <Color x:Key="PageBackgroundLight">#FBF7F2</Color>
    <Color x:Key="PageBackgroundDark">#15120F</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#221D19</Color>
    <Color x:Key="SurfaceVariantLight">#F4ECE2</Color>
    <Color x:Key="SurfaceVariantDark">#2F2823</Color>
    <Color x:Key="OutlineLight">#ECE3D8</Color>
    <Color x:Key="OutlineDark">#3A322C</Color>
    <Color x:Key="TextPrimaryLight">#2B2420</Color>
    <Color x:Key="TextPrimaryDark">#F5EFE9</Color>
    <Color x:Key="TextSecondaryLight">#75685D</Color>
    <Color x:Key="TextSecondaryDark">#B5A99E</Color>
    <Color x:Key="TabBarLight">#FFFFFF</Color>
    <Color x:Key="TabBarDark">#1C1815</Color>
    <Color x:Key="TabUnselectedLight">#75685D</Color>
    <Color x:Key="TabUnselectedDark">#8F8378</Color>

    <!-- Flyout header gradient. -->
    <Color x:Key="SunriseStartLight">#B53D20</Color>
    <Color x:Key="SunriseEndLight">#B3541C</Color>
    <Color x:Key="SunriseStartDark">#8E321C</Color>
    <Color x:Key="SunriseEndDark">#8A4514</Color>

</ResourceDictionary>
