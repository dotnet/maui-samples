<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xaminals.Controls.FlyoutHeader"
             HeightRequest="200">
    <Border Margin="12,8,12,12"
            Padding="20,0,20,18"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 24">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource SunriseStartLight}, Dark={StaticResource SunriseStartDark}}"
                              Offset="0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource SunriseEndLight}, Dark={StaticResource SunriseEndDark}}"
                              Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid RowDefinitions="*,Auto,Auto">
            <HorizontalStackLayout Spacing="2"
                                   VerticalOptions="End"
                                   Margin="0,0,0,8">
                <Image Source="cat.png"
                       WidthRequest="40"
                       HeightRequest="40" />
                <Image Source="dog.png"
                       WidthRequest="40"
                       HeightRequest="40" />
                <Image Source="monkey.png"
                       WidthRequest="40"
                       HeightRequest="40" />
                <Image Source="elephant.png"
                       WidthRequest="40"
                       HeightRequest="40" />
                <Image Source="bear.png"
                       WidthRequest="40"
                       HeightRequest="40" />
            </HorizontalStackLayout>
            <Label Grid.Row="1"
                   Text="Xaminals"
                   Style="{StaticResource DisplayTitle}"
                   TextColor="White" />
            <Label Grid.Row="2"
                   Text="A .NET MAUI Shell sample"
                   FontFamily="NunitoSemiBold"
                   TextColor="White" />
        </Grid>
    </Border>
</ContentView>
