    <!-- Template each FlyoutItem -->
    <!-- Not required, the style classes above restyle the default template -->
    <!--<Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Grid ColumnDefinitions="0.2*,0.8*">
                <Image Source="{Binding FlyoutIcon}"
