<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Xaminals.Models"
             x:Class="Xaminals.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Each row in the animal lists -->
            <DataTemplate x:Key="AnimalTemplate"
                          x:DataType="models:Animal">
                <Grid Padding="16,6">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14">
                            <Border Style="{StaticResource EmojiTile}">
                                <Image Source="{Binding ImageUrl}"
                                       WidthRequest="44"
                                       HeightRequest="44" />
                            </Border>
                            <Grid Grid.Column="1"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="2"
                                  VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource ItemTitle}" />
                                <Label Grid.Row="1"
                                       Text="{Binding Location}"
                                       Style="{StaticResource ItemSubtitle}" />
                            </Grid>
                            <Label Grid.Column="2"
                                   Style="{StaticResource Chevron}" />
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- Each suggestion in the search results -->
            <DataTemplate x:Key="AnimalSearchTemplate"
                          x:DataType="models:Animal">
                <Grid Padding="12,8"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Background="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border Style="{StaticResource EmojiTile}"
                            StrokeShape="RoundRectangle 12"
                            WidthRequest="40"
                            HeightRequest="40">
                        <Image Source="{Binding ImageUrl}"
                               WidthRequest="28"
                               HeightRequest="28" />
                    </Border>
                    <Grid Grid.Column="1"
                          RowDefinitions="Auto,Auto"
                          VerticalOptions="Center">
                        <Label Text="{Binding Name}"
                               FontFamily="NunitoSemiBold"
                               FontSize="16"
                               LineBreakMode="TailTruncation" />
                        <Label Grid.Row="1"
                               Text="{Binding Location}"
                               Style="{StaticResource ItemSubtitle}"
                               FontSize="13"
                               LineBreakMode="TailTruncation" />
                    </Grid>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
