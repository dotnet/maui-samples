<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                xmlns:models="clr-namespace:PlatformIntegrationDemo.Models"
                x:Class="PlatformIntegrationDemo.Views.PermissionsPage"
                Title="Permissions"
                x:DataType="viewmodels:PermissionsViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:PermissionsViewModel x:Name="viewModel" />
    </views:BasePage.BindingContext>

    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="App model" Style="{StaticResource Eyebrow}" />
            <Label Text="Permissions" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Check the status of a runtime permission, request it, and find out whether to show a rationale first." Style="{StaticResource Lead}" />
            <Border Style="{StaticResource ApiChip}">
                <Label Text="Permissions.RequestAsync()" Style="{StaticResource ApiChipLabel}" />
            </Border>
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}">
            <CollectionView ItemsSource="{Binding PermissionItems}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PermissionItem">
                        <VerticalStackLayout Padding="0,0,0,12"
                                             Spacing="8">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource Headline}" />
                                <Border Grid.Column="1"
                                        Style="{StaticResource StatusPill}">
                                    <Label Text="{Binding Status, Mode=OneWay}"
                                           Style="{StaticResource StatusPillLabel}" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding Rationale, Mode=OneWay}"
                                   Style="{StaticResource Caption}">
                                <Label.Triggers>
                                    <Trigger TargetType="Label" Property="Text" Value="{x:Null}">
                                        <Setter Property="IsVisible" Value="False" />
                                    </Trigger>
                                </Label.Triggers>
                            </Label>
                            <Grid ColumnDefinitions="*,*,*"
                                  ColumnSpacing="8">
                                <Button Text="Check"
                                        Style="{StaticResource TonalButton}"
                                        Padding="8,0"
                                        FontSize="14"
                                        Command="{Binding CheckStatusCommand}"
                                        SemanticProperties.Description="{Binding Title, StringFormat='Check {0}'}" />
                                <Button Grid.Column="1"
                                        Text="Request"
                                        Style="{StaticResource TonalButton}"
                                        Padding="8,0"
                                        FontSize="14"
                                        Command="{Binding RequestCommand}"
                                        SemanticProperties.Description="{Binding Title, StringFormat='Request {0}'}" />
                                <Button Grid.Column="2"
                                        Text="Rationale"
                                        Style="{StaticResource TonalButton}"
                                        Padding="8,0"
                                        FontSize="14"
                                        Command="{Binding ShouldShowRationaleCommand}"
                                        SemanticProperties.Description="{Binding Title, StringFormat='Show rationale for {0}'}" />
                            </Grid>
                            <BoxView Style="{StaticResource Divider}"
                                     Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</views:BasePage>
