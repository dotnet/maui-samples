<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.AllSensorsPage"
                Title="All Sensors">
    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Sensors" Style="{StaticResource Eyebrow}" />
                <Label Text="All Sensors" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Run the motion and environment sensors side by side. Each card uses its own view model." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="Microsoft.Maui.Devices.Sensors" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1" x:Name="GridAccelerometer"
                    x:DataType="viewmodels:AccelerometerViewModel"
                    Style="{StaticResource DemoSurface}">
                <Border.BindingContext>
                    <viewmodels:AccelerometerViewModel />
                </Border.BindingContext>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Accelerometer"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="10">
                        <Border Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="X" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding X, StringFormat='{0:N2}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Y" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding Y, StringFormat='{0:N2}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Z" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding Z, StringFormat='{0:N2}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sensor speed" Style="{StaticResource Caption}" />
                        <Picker SemanticProperties.Description="Sensor speed"
                                ItemsSource="{Binding Speeds}"
                                SelectedIndex="{Binding Speed, Mode=TwoWay}"
                                IsEnabled="{Binding IsActive, Converter={StaticResource InverterConverter}}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Start"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding IsActive, Converter={StaticResource InverterConverter}}" />
                        <Button Grid.Column="1"
                                Text="Stop"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsActive}" />
                    </Grid>
                    <Label Text="{Binding ShakeTime}"
                           Style="{StaticResource Output}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="2" x:Name="GridBarometer"
                    x:DataType="viewmodels:BarometerViewModel"
                    Style="{StaticResource DemoSurface}">
                <Border.BindingContext>
                    <viewmodels:BarometerViewModel />
                </Border.BindingContext>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Barometer"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*"
                          ColumnSpacing="10">
                        <Border Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Pressure (hPa)" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding Pressure, StringFormat='{0:N2}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sensor speed" Style="{StaticResource Caption}" />
                        <Picker SemanticProperties.Description="Sensor speed"
                                ItemsSource="{Binding Speeds}"
                                SelectedIndex="{Binding Speed, Mode=TwoWay}"
                                IsEnabled="{Binding IsActive, Converter={StaticResource InverterConverter}}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Start"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding IsActive, Converter={StaticResource InverterConverter}}" />
                        <Button Grid.Column="1"
                                Text="Stop"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsActive}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="3" x:Name="GridCompass"
                    x:DataType="viewmodels:CompassViewModel"
                    Style="{StaticResource DemoSurface}">
                <Border.BindingContext>
                    <viewmodels:CompassViewModel />
                </Border.BindingContext>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Compass"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*"
                          ColumnSpacing="10">
                        <Border Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Heading (°)" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding Heading, StringFormat='{0:N1}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <Label Text="Apply low-pass filter" Style="{StaticResource SwitchLabel}" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding ApplyLowPassFilter}"
                                SemanticProperties.Description="Apply low-pass filter" />
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sensor speed" Style="{StaticResource Caption}" />
                        <Picker SemanticProperties.Description="Sensor speed"
                                ItemsSource="{Binding Speeds}"
                                SelectedIndex="{Binding Speed, Mode=TwoWay}"
                                IsEnabled="{Binding IsActive, Converter={StaticResource InverterConverter}}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Start"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding IsActive, Converter={StaticResource InverterConverter}}" />
                        <Button Grid.Column="1"
                                Text="Stop"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsActive}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="4" x:Name="GridGyro"
                    x:DataType="viewmodels:GyroscopeViewModel"
                    Style="{StaticResource DemoSurface}">
                <Border.BindingContext>
                    <viewmodels:GyroscopeViewModel />
                </Border.BindingContext>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Gyroscope"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="10">
                        <Border Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="X" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding X, StringFormat='{0:N2}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Y" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding Y, StringFormat='{0:N2}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Z" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding Z, StringFormat='{0:N2}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sensor speed" Style="{StaticResource Caption}" />
                        <Picker SemanticProperties.Description="Sensor speed"
                                ItemsSource="{Binding Speeds}"
                                SelectedIndex="{Binding Speed, Mode=TwoWay}"
                                IsEnabled="{Binding IsActive, Converter={StaticResource InverterConverter}}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Start"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding IsActive, Converter={StaticResource InverterConverter}}" />
                        <Button Grid.Column="1"
                                Text="Stop"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsActive}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="5" x:Name="GridMagnetometer"
                    x:DataType="viewmodels:MagnetometerViewModel"
                    Style="{StaticResource DemoSurface}">
                <Border.BindingContext>
                    <viewmodels:MagnetometerViewModel />
                </Border.BindingContext>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Magnetometer"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="10">
                        <Border Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="X (µT)" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding X, StringFormat='{0:N1}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Y (µT)" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding Y, StringFormat='{0:N1}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Z (µT)" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding Z, StringFormat='{0:N1}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sensor speed" Style="{StaticResource Caption}" />
                        <Picker SemanticProperties.Description="Sensor speed"
                                ItemsSource="{Binding Speeds}"
                                SelectedIndex="{Binding Speed, Mode=TwoWay}"
                                IsEnabled="{Binding IsActive, Converter={StaticResource InverterConverter}}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Start"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding IsActive, Converter={StaticResource InverterConverter}}" />
                        <Button Grid.Column="1"
                                Text="Stop"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsActive}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="6" x:Name="GridOrientation"
                    x:DataType="viewmodels:OrientationSensorViewModel"
                    Style="{StaticResource DemoSurface}">
                <Border.BindingContext>
                    <viewmodels:OrientationSensorViewModel />
                </Border.BindingContext>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Orientation sensor"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="10">
                        <Border Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="X" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding X, StringFormat='{0:N2}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Y" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding Y, StringFormat='{0:N2}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Z" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding Z, StringFormat='{0:N2}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ReadoutTile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="W" Style="{StaticResource ReadoutCaption}" />
                                <Label Text="{Binding W, StringFormat='{0:N2}'}" Style="{StaticResource ReadoutValue}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sensor speed" Style="{StaticResource Caption}" />
                        <Picker SemanticProperties.Description="Sensor speed"
                                ItemsSource="{Binding Speeds}"
                                SelectedIndex="{Binding Speed, Mode=TwoWay}"
                                IsEnabled="{Binding IsActive, Converter={StaticResource InverterConverter}}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Start"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding IsActive, Converter={StaticResource InverterConverter}}" />
                        <Button Grid.Column="1"
                                Text="Stop"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsActive}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
