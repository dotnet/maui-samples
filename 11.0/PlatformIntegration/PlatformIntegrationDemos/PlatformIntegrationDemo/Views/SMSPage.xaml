<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.SMSPage"
                Title="SMS"
                x:DataType="viewmodels:SmsViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:SmsViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Communication" Style="{StaticResource Eyebrow}" />
                <Label Text="SMS" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Open the messaging app with the recipients and message filled in." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="Sms.ComposeAsync()" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Recipients (optional, separate with commas)" Style="{StaticResource Caption}" />
                        <Entry SemanticProperties.Hint="Recipients (optional, separate with commas)"
                               Keyboard="Telephone"
                               Text="{Binding Recipient}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Message (optional)" Style="{StaticResource Caption}" />
                        <Editor SemanticProperties.Hint="Message (optional)"
                                Text="{Binding MessageText}"
                                Keyboard="Chat"
                                AutoSize="TextChanges" />
                    </VerticalStackLayout>
                    <Button Text="Compose SMS"
                            Command="{Binding SendSmsCommand}" />
                    <ActivityIndicator IsVisible="{Binding IsBusy}"
                                       IsRunning="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
