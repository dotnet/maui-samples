<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.ClipboardPage"
                Title="Clipboard"
                x:DataType="viewmodels:ClipboardViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:ClipboardViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Sharing" Style="{StaticResource Eyebrow}" />
                <Label Text="Clipboard" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Copy text to the clipboard and paste it back. The page also listens for clipboard changes." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="Clipboard.SetTextAsync()" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Text" Style="{StaticResource Caption}" />
                        <Entry SemanticProperties.Hint="Text"
                               Placeholder="Enter text"
                               Text="{Binding FieldValue}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Copy"
                                Command="{Binding CopyCommand}" />
                        <Button Grid.Column="1"
                                Text="Paste"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding PasteCommand}" />
                    </Grid>
                    <Button Text="Check for text"
                            Style="{StaticResource TonalButton}"
                            Command="{Binding CheckCommand}" />
                    <Label Text="{Binding LastCopied}"
                           Style="{StaticResource Output}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
