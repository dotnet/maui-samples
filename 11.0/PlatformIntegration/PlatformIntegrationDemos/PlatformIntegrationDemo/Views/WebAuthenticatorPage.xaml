<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.WebAuthenticatorPage"
                Title="Web Authenticator"
                x:DataType="viewmodels:WebAuthenticatorViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:WebAuthenticatorViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Communication" Style="{StaticResource Eyebrow}" />
                <Label Text="Web Authenticator" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Start a browser-based sign-in flow and wait for the callback to the app. This demo uses a sample server." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="WebAuthenticator.AuthenticateAsync()" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Sign in with"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">
                        <Button Text="Microsoft"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding MicrosoftCommand}" />
                        <Button Grid.Column="1"
                                Text="Google"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding GoogleCommand}" />
                        <Button Grid.Row="1"
                                Text="Facebook"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding FacebookCommand}" />
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Text="Apple"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding AppleCommand}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Label Text="Result"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{Binding AuthToken}"
                           Style="{StaticResource Output}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
