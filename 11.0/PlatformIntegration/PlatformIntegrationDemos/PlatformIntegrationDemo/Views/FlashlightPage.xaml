<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                xmlns:local="clr-namespace:PlatformIntegrationDemo"
                x:Class="PlatformIntegrationDemo.Views.FlashlightPage"
                Title="Flashlight"
                x:DataType="viewmodels:FlashlightViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:FlashlightViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Device" Style="{StaticResource Eyebrow}" />
                <Label Text="Flashlight" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Turn the camera flash on and off, after checking that the device has one." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="Flashlight.TurnOnAsync()" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static local:MaterialIcons.FlashlightOn}"
                           Style="{StaticResource Icon}"
                           FontSize="56"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="The flashlight is on"
                           Style="{StaticResource Value}"
                           IsVisible="{Binding IsOn}" />
                    <Label Text="The flashlight is off"
                           Style="{StaticResource Value}"
                           IsVisible="{Binding IsOn, Converter={StaticResource InverterConverter}}" />
                    <Button Text="Toggle flashlight"
                            Command="{Binding ToggleCommand}" />
                    <Border Style="{StaticResource Hint}"
                            IsVisible="{Binding IsSupported, Converter={StaticResource InverterConverter}}">
                        <Label Text="This device doesn't have a flashlight." Style="{StaticResource WarningLabel}" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
