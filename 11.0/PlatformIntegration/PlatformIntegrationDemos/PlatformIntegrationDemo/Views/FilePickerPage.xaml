<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.FilePickerPage"
                Title="File Picker"
                x:DataType="viewmodels:FilePickerViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:FilePickerViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Storage" Style="{StaticResource Eyebrow}" />
                <Label Text="File Picker" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Let the user pick one or more files. You can limit the picker to images, PDFs, or your own file types." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="FilePicker.PickAsync()" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="12">
                    <Button Text="Pick a file"
                            Command="{Binding PickFileCommand}" />
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Pick an image"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding PickImageCommand}" />
                        <Button Grid.Column="1"
                                Text="Pick a PDF"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding PickPdfCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Custom type"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding PickCustomTypeCommand}" />
                        <Button Grid.Column="1"
                                Text="Multiple files"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding PickMultipleFilesCommand}" />
                    </Grid>
                    <Button Text="Pick an image and email it"
                            Style="{StaticResource TonalButton}"
                            Command="{Binding PickAndSendCommand}" />
                    <Label Text="{Binding Text}"
                           Style="{StaticResource Output}" />
                    <Image Source="{Binding Image}"
                           SemanticProperties.Description="The picked image"
                           IsVisible="{Binding IsImageVisible}"
                           MaximumHeightRequest="300" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
