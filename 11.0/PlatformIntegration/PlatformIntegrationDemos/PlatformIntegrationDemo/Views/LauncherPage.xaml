<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.LauncherPage"
                Title="Launcher"
                x:DataType="viewmodels:LauncherViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:LauncherViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="App model" Style="{StaticResource Eyebrow}" />
                <Label Text="Launcher" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Check whether another app can handle a URI, then open it. You can also open a file in the app that handles its type." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="Launcher.OpenAsync()" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="URI" Style="{StaticResource Caption}" />
                        <Entry SemanticProperties.Hint="URI"
                               Keyboard="Url"
                               Text="{Binding LaunchUri}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Can open?"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding CanLaunchCommand}" />
                        <Button Grid.Column="1"
                                Text="Open"
                                Command="{Binding LaunchCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Open browser"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding LaunchBrowserCommand}" />
                        <Button Grid.Column="1"
                                Text="Open mail"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding LaunchMailCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="2"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Open a file"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="File name" Style="{StaticResource Caption}" />
                        <Entry SemanticProperties.Hint="File name"
                               Text="{Binding FileAttachmentName}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="File contents" Style="{StaticResource Caption}" />
                        <Editor SemanticProperties.Hint="File contents"
                                Text="{Binding FileAttachmentContents}"
                                AutoSize="TextChanges" />
                    </VerticalStackLayout>
                    <Button Text="Open file"
                            Command="{Binding LaunchFileCommand}"
                            CommandParameter="{Binding Source={RelativeSource Self}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
