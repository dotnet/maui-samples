<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.ColorConvertersPage"
                Title="Color Converters"
                x:DataType="viewmodels:ColorConvertersViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:ColorConvertersViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Media" Style="{StaticResource Eyebrow}" />
                <Label Text="Color Converters" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Parse a hex color, then create new colors from it by changing its alpha, hue, luminosity, or saturation." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="Color.FromArgb()" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Hex color" Style="{StaticResource Caption}" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Entry SemanticProperties.Hint="Hex color"
                                   Text="{Binding Hex}" />
                            <BoxView Grid.Column="1"
                                     Color="{Binding RegularColor}"
                                     CornerRadius="10"
                                     WidthRequest="64"
                                     HeightRequest="36"
                                     VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Complementary color" Style="{StaticResource Caption}" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Label Text="{Binding ComplementHex}"
                                   VerticalOptions="Center" />
                            <BoxView Grid.Column="1"
                                     Color="{Binding ComplementColor}"
                                     CornerRadius="10"
                                     WidthRequest="64"
                                     HeightRequest="36"
                                     VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Alpha, StringFormat='Alpha: {0:F0}'}" Style="{StaticResource Caption}" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Slider SemanticProperties.Description="Alpha"
                                    Minimum="0"
                                    Maximum="255"
                                    Value="{Binding Alpha}"
                                    VerticalOptions="Center" />
                            <BoxView Grid.Column="1"
                                     Color="{Binding AlphaColor}"
                                     CornerRadius="10"
                                     WidthRequest="64"
                                     HeightRequest="36"
                                     VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Hue, StringFormat='Hue: {0:F0}'}" Style="{StaticResource Caption}" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Slider SemanticProperties.Description="Hue"
                                    Minimum="0"
                                    Maximum="360"
                                    Value="{Binding Hue}"
                                    VerticalOptions="Center" />
                            <BoxView Grid.Column="1"
                                     Color="{Binding HueColor}"
                                     CornerRadius="10"
                                     WidthRequest="64"
                                     HeightRequest="36"
                                     VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Luminosity, StringFormat='Luminosity: {0:F0}'}" Style="{StaticResource Caption}" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Slider SemanticProperties.Description="Luminosity"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding Luminosity}"
                                    VerticalOptions="Center" />
                            <BoxView Grid.Column="1"
                                     Color="{Binding LuminosityColor}"
                                     CornerRadius="10"
                                     WidthRequest="64"
                                     HeightRequest="36"
                                     VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Saturation, StringFormat='Saturation: {0:F0}'}" Style="{StaticResource Caption}" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Slider SemanticProperties.Description="Saturation"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding Saturation}"
                                    VerticalOptions="Center" />
                            <BoxView Grid.Column="1"
                                     Color="{Binding SaturationColor}"
                                     CornerRadius="10"
                                     WidthRequest="64"
                                     HeightRequest="36"
                                     VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
