<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.GeolocationPage"
                Title="Geolocation"
                x:DataType="viewmodels:GeolocationViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:GeolocationViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Location" Style="{StaticResource Eyebrow}" />
                <Label Text="Geolocation" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Get the last known location, request the current location, or listen for location changes." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="Geolocation.GetLocationAsync()" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Last known location"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{Binding LastLocation}"
                           Style="{StaticResource Output}" />
                    <Button Text="Get last known location"
                            Command="{Binding GetLastLocationCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="2"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Current location"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{Binding CurrentLocation}"
                           Style="{StaticResource Output}" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Accuracy" Style="{StaticResource Caption}" />
                        <Picker SemanticProperties.Description="Accuracy"
                                ItemsSource="{Binding Accuracies}"
                                SelectedIndex="{Binding Accuracy, Mode=TwoWay}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>
                    <Button Text="Get current location"
                            Command="{Binding GetCurrentLocationCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsVisible="{Binding IsBusy}"
                                       IsRunning="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="3"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Listen in the foreground"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Start"
                                Command="{Binding StartListeningCommand}"
                                IsEnabled="{Binding IsNotListening}" />
                        <Button Grid.Column="1"
                                Text="Stop"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding StopListeningCommand}"
                                IsEnabled="{Binding IsListening}" />
                    </Grid>
                    <Label Text="{Binding ListeningLocationStatus}"
                           Style="{StaticResource Output}" />
                    <Label Text="{Binding ListeningLocation}"
                           Style="{StaticResource Output}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
