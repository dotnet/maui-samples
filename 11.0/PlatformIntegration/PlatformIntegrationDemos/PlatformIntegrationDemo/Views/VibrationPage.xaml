<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.VibrationPage"
                Title="Vibration"
                x:DataType="viewmodels:VibrationViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:VibrationViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Device" Style="{StaticResource Eyebrow}" />
                <Label Text="Vibration" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Vibrate the device for a duration you choose, and cancel the vibration early. On iOS the system decides the duration." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="Vibration.Vibrate()" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Duration" Style="{StaticResource Caption}" />
                        <Label Text="{Binding Duration, StringFormat='{0:N0} ms'}"
                               Style="{StaticResource Value}"
                               HorizontalTextAlignment="Start" />
                        <Slider SemanticProperties.Description="Duration"
                                Minimum="0"
                                Maximum="5000"
                                Value="{Binding Duration}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Vibrate"
                                Command="{Binding VibrateCommand}" />
                        <Button Grid.Column="1"
                                Text="Cancel"
                                Style="{StaticResource TonalButton}"
                                Command="{Binding CancelCommand}" />
                    </Grid>
                    <Border Style="{StaticResource Hint}"
                            IsVisible="{Binding IsSupported, Converter={StaticResource InverterConverter}}">
                        <Label Text="This device doesn't support vibration." Style="{StaticResource WarningLabel}" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
