<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.BrowserPage"
                Title="Browser"
                x:DataType="viewmodels:BrowserViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:BrowserViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="App model" Style="{StaticResource Eyebrow}" />
                <Label Text="Browser" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Open a website in the system browser or in a browser inside the app, with optional styling." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="Browser.OpenAsync()" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="URI" Style="{StaticResource Caption}" />
                        <Entry SemanticProperties.Hint="URI"
                               Placeholder="https://..."
                               Keyboard="Url"
                               Text="{Binding Uri}" />
                    </VerticalStackLayout>
                    <Button Text="Open URI"
                            Command="{Binding OpenUriCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Label Text="{Binding BrowserStatus}"
                           Style="{StaticResource Output}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="2"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Launch options"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Launch mode" Style="{StaticResource Caption}" />
                        <Picker SemanticProperties.Description="Launch mode"
                                ItemsSource="{Binding BrowserLaunchModes}"
                                SelectedIndex="{Binding BrowserType, Mode=TwoWay}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Title mode" Style="{StaticResource Caption}" />
                        <Picker SemanticProperties.Description="Title mode"
                                ItemsSource="{Binding BrowserTitleModes}"
                                SelectedIndex="{Binding BrowserTitleType, Mode=TwoWay}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Toolbar color" Style="{StaticResource Caption}" />
                        <Picker SemanticProperties.Description="Toolbar color"
                                ItemsSource="{Binding AllColors}"
                                SelectedIndex="{Binding ToolbarColor, Mode=TwoWay}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Control tint color (iOS)" Style="{StaticResource Caption}" />
                        <Picker SemanticProperties.Description="Control tint color (iOS)"
                                ItemsSource="{Binding AllColors}"
                                SelectedIndex="{Binding ControlColor, Mode=TwoWay}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <Label Text="Launch adjacent (Android)" Style="{StaticResource SwitchLabel}" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding LaunchAdjacent, Mode=TwoWay}"
                                SemanticProperties.Description="Launch adjacent (Android)" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <Label Text="Present as form sheet (iOS)" Style="{StaticResource SwitchLabel}" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding PresentAsFormSheet, Mode=TwoWay}"
                                SemanticProperties.Description="Present as form sheet (iOS)" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <Label Text="Present as page sheet (iOS)" Style="{StaticResource SwitchLabel}" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding PresentAsPageSheet, Mode=TwoWay}"
                                SemanticProperties.Description="Present as page sheet (iOS)" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
