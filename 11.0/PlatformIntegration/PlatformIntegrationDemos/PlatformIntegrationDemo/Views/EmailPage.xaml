<?xml version="1.0" ?><views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:views="clr-namespace:PlatformIntegrationDemo.Views" xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels" x:Class="PlatformIntegrationDemo.Views.EmailPage" Title="Email" x:DataType="viewmodels:EmailViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:EmailViewModel/>
    </views:BasePage.BindingContext>

    <views:BasePage.ToolbarItems>
        <ToolbarItem Text="Send" Command="{Binding SendEmailCommand}" IsEnabled="{Binding IsNotBusy}"/>
    </views:BasePage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <Label Text="Easily send email messages." FontAttributes="Bold" Margin="12"/>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="12,0,12,12" Spacing="6">
                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"/>

                <Button Text="Send Email" Command="{Binding SendEmailCommand}" IsEnabled="{Binding IsNotBusy}"/>

                <Label Text="Recipients" FontAttributes="Bold" Margin="0,6,0,0"/>
                <Label Text="To:"/>
                <Entry Text="{Binding RecipientsTo}"/>
                <Label Text="CC:"/>
                <Entry Text="{Binding RecipientsCc}"/>
                <Label Text="BCC:"/>
                <Entry Text="{Binding RecipientsBcc}"/>

                <Label Text="Message" FontAttributes="Bold" Margin="0,6,0,0"/>
                <Label Text="Subject:"/>
                <Entry Text="{Binding Subject}"/>
                <Grid ColumnSpacing="6" ColumnDefinitions="*,Auto">
                    <Label Text="Is Html?" HorizontalTextAlignment="End" HorizontalOptions="Fill" VerticalOptions="Center" Grid.Column="0"/>
                    <Switch IsToggled="{Binding IsHtml}" VerticalOptions="Center" Grid.Column="1"/>
                </Grid>
                <Label Text="Body:"/>
                <Editor Text="{Binding Body}" Keyboard="Chat" AutoSize="TextChanges"/>

                <Label Text="Attachment" FontAttributes="Bold" Margin="0,6,0,0"/>

                <Label Text="File Name:"/>
                <Entry Text="{Binding AttachmentName}"/>
                <Label Text="File Contents:"/>
                <Editor Text="{Binding AttachmentContents}" Keyboard="Chat" AutoSize="TextChanges"/>

                <Grid ColumnSpacing="6" ColumnDefinitions="*,Auto">
                    <Label Text="Attach Multiple" HorizontalTextAlignment="End" HorizontalOptions="Fill" VerticalOptions="Center" Grid.Column="0"/>
                    <Switch IsToggled="{Binding HasMultipleAttachements}" VerticalOptions="Center" Grid.Column="1"/>
                </Grid>

                <Button Text="Send Email" Command="{Binding SendEmailCommand}" IsEnabled="{Binding IsNotBusy}"/>

            </StackLayout>
        </ScrollView>
    </Grid>
</views:BasePage>
