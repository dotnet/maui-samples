<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.SharePage"
                Title="Share"
                x:DataType="viewmodels:ShareViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:ShareViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Sharing" Style="{StaticResource Eyebrow}" />
                <Label Text="Share" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Send text, a link, or files to other apps with the system share sheet." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="Share.RequestAsync()" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Share text and a link"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Title (optional)" Style="{StaticResource Caption}" />
                        <Entry SemanticProperties.Hint="Title (optional)"
                               Text="{Binding Title}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Subject (optional)" Style="{StaticResource Caption}" />
                        <Entry SemanticProperties.Hint="Subject (optional)"
                               Text="{Binding Subject}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <Label Text="Include text" Style="{StaticResource SwitchLabel}" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding ShareText}"
                                SemanticProperties.Description="Include text" />
                    </Grid>
                    <Editor Text="{Binding Text}"
                            IsEnabled="{Binding ShareText}"
                            SemanticProperties.Hint="Text to share"
                            Placeholder="Enter text to share"
                            Keyboard="Chat"
                            AutoSize="TextChanges" />
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <Label Text="Include a link" Style="{StaticResource SwitchLabel}" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding ShareUri}"
                                SemanticProperties.Description="Include a link" />
                    </Grid>
                    <Entry Text="{Binding Uri}"
                           IsEnabled="{Binding ShareUri}"
                           SemanticProperties.Hint="Link to share"
                           Placeholder="Enter a URI to share"
                           Keyboard="Url" />
                    <Button Text="Share text"
                            Command="{Binding RequestCommand}"
                            CommandParameter="{Binding Source={RelativeSource Self}}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="2"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Share a file"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Title (optional)" Style="{StaticResource Caption}" />
                        <Entry SemanticProperties.Hint="Title (optional)"
                               Text="{Binding ShareFileTitle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="File name" Style="{StaticResource Caption}" />
                        <Entry SemanticProperties.Hint="File name"
                               Text="{Binding ShareFileAttachmentName}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="File contents" Style="{StaticResource Caption}" />
                        <Editor SemanticProperties.Hint="File contents"
                                Text="{Binding ShareFileAttachmentContents}"
                                Keyboard="Chat"
                                AutoSize="TextChanges" />
                    </VerticalStackLayout>
                    <Button Text="Share file"
                            Command="{Binding RequestFileCommand}"
                            CommandParameter="{Binding Source={RelativeSource Self}}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="3"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Share multiple files"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Title (optional)" Style="{StaticResource Caption}" />
                        <Entry SemanticProperties.Hint="Title (optional)"
                               Text="{Binding ShareFilesTitle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="First file name" Style="{StaticResource Caption}" />
                        <Entry SemanticProperties.Hint="First file name"
                               Text="{Binding ShareFile1AttachmentName}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="First file contents" Style="{StaticResource Caption}" />
                        <Editor SemanticProperties.Hint="First file contents"
                                Text="{Binding ShareFile1AttachmentContents}"
                                Keyboard="Chat"
                                AutoSize="TextChanges" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Second file name" Style="{StaticResource Caption}" />
                        <Entry SemanticProperties.Hint="Second file name"
                               Text="{Binding ShareFile2AttachmentName}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Second file contents" Style="{StaticResource Caption}" />
                        <Editor SemanticProperties.Hint="Second file contents"
                                Text="{Binding ShareFile2AttachmentContents}"
                                Keyboard="Chat"
                                AutoSize="TextChanges" />
                    </VerticalStackLayout>
                    <Button Text="Share files"
                            Command="{Binding RequestFilesCommand}"
                            CommandParameter="{Binding Source={RelativeSource Self}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
