<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                xmlns:appmodel="clr-namespace:Microsoft.Maui.ApplicationModel.Communication;assembly=Microsoft.Maui.Essentials"
                x:Class="PlatformIntegrationDemo.Views.ContactsPage"
                Title="Contacts"
                x:DataType="viewmodels:ContactsViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:ContactsViewModel />
    </views:BasePage.BindingContext>

    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Communication" Style="{StaticResource Eyebrow}" />
            <Label Text="Contacts" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Pick a single contact, or read every contact on the device. Select a contact to see its details." Style="{StaticResource Lead}" />
            <Border Style="{StaticResource ApiChip}">
                <Label Text="Contacts.PickContactAsync()" Style="{StaticResource ApiChipLabel}" />
            </Border>
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="12">
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">
                    <Button Text="Pick contact"
                            Command="{Binding GetContactCommand}" />
                    <Button Grid.Column="1"
                            Text="Get all"
                            Style="{StaticResource TonalButton}"
                            Command="{Binding GetAllContactCommand}" />
                </Grid>
                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding ContactsList}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedContact}">
                    <CollectionView.EmptyView>
                        <Label Text="Contacts you pick or read appear here."
                               Style="{StaticResource Output}"
                               HorizontalTextAlignment="Center"
                               Margin="0,24" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="appmodel:Contact">
                            <VerticalStackLayout Padding="0,12,0,0"
                                                 Spacing="12">
                                <Label Text="{Binding DisplayName}"
                                       Style="{StaticResource Headline}"
                                       LineBreakMode="TailTruncation" />
                                <BoxView Style="{StaticResource Divider}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</views:BasePage>
