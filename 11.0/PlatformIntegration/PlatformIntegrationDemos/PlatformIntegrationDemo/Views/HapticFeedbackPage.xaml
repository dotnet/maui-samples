<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.HapticFeedbackPage"
                Title="Haptic Feedback"
                x:DataType="viewmodels:HapticFeedbackViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:HapticFeedbackViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="Device" Style="{StaticResource Eyebrow}" />
                <Label Text="Haptic Feedback" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Play a short haptic effect, the same kind the system uses for a tap or a long press." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="HapticFeedback.Perform()" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Click"
                                Command="{Binding ClickCommand}" />
                        <Button Grid.Column="1"
                                Text="Long press"
                                Command="{Binding LongPressCommand}" />
                    </Grid>
                    <Border Style="{StaticResource Hint}"
                            IsVisible="{Binding IsSupported, Converter={StaticResource InverterConverter}}">
                        <Label Text="This device doesn't support haptic feedback." Style="{StaticResource WarningLabel}" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
