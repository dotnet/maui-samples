<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PlatformIntegrationDemo.Views"
                xmlns:viewmodels="clr-namespace:PlatformIntegrationDemo.ViewModels"
                x:Class="PlatformIntegrationDemo.Views.AppInfoPage"
                Title="App Info"
                x:DataType="viewmodels:AppInfoViewModel">
    <views:BasePage.BindingContext>
        <viewmodels:AppInfoViewModel />
    </views:BasePage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto"
              Style="{StaticResource DemoLayout}">
            <VerticalStackLayout Style="{StaticResource DemoHeader}">
                <Label Text="App model" Style="{StaticResource Eyebrow}" />
                <Label Text="App Info" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Read information about the app, such as its name, version, and the theme it was asked to use." Style="{StaticResource Lead}" />
                <Border Style="{StaticResource ApiChip}">
                    <Label Text="AppInfo.VersionString" Style="{StaticResource ApiChipLabel}" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource DemoSurface}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Name" Style="{StaticResource Caption}" />
                        <Label Text="{Binding AppName}"
                               Style="{StaticResource PropertyValue}"
                               FontSize="14"
                               HorizontalTextAlignment="Start" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Package name" Style="{StaticResource Caption}" />
                        <Label Text="{Binding AppPackageName}"
                               Style="{StaticResource PropertyValue}"
                               FontSize="14"
                               HorizontalTextAlignment="Start" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="16"
                          RowSpacing="12"
                          RowDefinitions="Auto,Auto,Auto">
                        <Label Text="Requested theme" Style="{StaticResource PropertyName}" />
                        <Label Grid.Column="1" Text="{Binding AppTheme}" Style="{StaticResource PropertyValue}" />
                        <Label Grid.Row="1" Text="Version" Style="{StaticResource PropertyName}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource PropertyValue}" />
                        <Label Grid.Row="2" Text="Build" Style="{StaticResource PropertyName}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding AppBuild}" Style="{StaticResource PropertyValue}" />
                    </Grid>
                    <Button Text="Open app settings"
                            Command="{Binding ShowSettingsUICommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>
