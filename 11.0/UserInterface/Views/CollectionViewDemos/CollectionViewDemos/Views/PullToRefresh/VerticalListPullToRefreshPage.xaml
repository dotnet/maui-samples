<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CollectionViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CollectionViewDemos.ViewModels"
             x:Class="CollectionViewDemos.Views.VerticalListPullToRefreshPage"
             Title="Refresh a vertical list"
             x:DataType="viewmodels:AnimalsViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Pull to refresh" Style="{StaticResource Eyebrow}" />
            <Label Text="Refresh a vertical list" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="A RefreshView wraps the CollectionView. Pulling down runs its Command, which loads more animals while IsRefreshing shows the indicator." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource Hint}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <Label Text="Pull down to refresh."
                       Style="{StaticResource HintLabel}" />
                <Label Grid.Column="1"
                       Text="{Binding Animals.Count, StringFormat='Number of items: {0}'}"
                       Style="{StaticResource HintLabel}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource ListSurface}">
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Animals}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Animal">
                            <Grid Padding="16,10"
                                  RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14">
                                <Image Grid.RowSpan="2"
                                       Source="{Binding ImageUrl}"
                                       HeightRequest="48"
                                       WidthRequest="48" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       Style="{StaticResource Headline}"
                                       VerticalOptions="End" />
                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding Location}"
                                       Style="{StaticResource Caption}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Border>
    </Grid>
</ContentPage>
