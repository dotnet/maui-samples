<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CollectionViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CollectionViewDemos.ViewModels"
             x:Class="CollectionViewDemos.Views.VerticalListHeaderFooterDataTemplatePage"
             Title="Templated header and footer"
             x:DataType="viewmodels:MonkeysViewModel">
    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Headers and footers" Style="{StaticResource Eyebrow}" />
            <Label Text="Templated header and footer" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="HeaderTemplate and FooterTemplate define the header and footer with DataTemplates. Scroll to the end to see the footer." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource ListSurface}">
            <CollectionView ItemsSource="{Binding Monkeys}">
                <CollectionView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="16,14"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              Background="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}">
                            <Image Source="monkey_face.png"
                                   HeightRequest="32"
                                   WidthRequest="32" />
                            <Label Grid.Column="1"
                                   Text="Monkeys"
                                   Style="{StaticResource Title2}"
                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.HeaderTemplate>
                <CollectionView.FooterTemplate>
                    <DataTemplate>
                        <Grid Padding="16,12"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              Background="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}">
                            <Image Source="dotnet_bot.png"
                                   HeightRequest="32"
                                   WidthRequest="52" />
                            <Label Grid.Column="1"
                                   Text="Friends of Xamarin Monkey"
                                   Style="{StaticResource Caption}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.FooterTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Monkey">
                        <Grid Padding="16,10"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">
                            <Image Grid.RowSpan="2"
                                   Source="{Binding ImageUrl}"
                                   HeightRequest="48"
                                   WidthRequest="48" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   Style="{StaticResource Headline}"
                                   VerticalOptions="End" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Location}"
                                   Style="{StaticResource Caption}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
