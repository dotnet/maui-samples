<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CollectionViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CollectionViewDemos.ViewModels"
             x:Class="CollectionViewDemos.Views.HorizontalGridHeaderFooterViewPage"
             Title="Horizontal grid header and footer"
             x:DataType="viewmodels:MonkeysViewModel">
    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Headers and footers" Style="{StaticResource Eyebrow}" />
            <Label Text="Horizontal grid header and footer" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="In a horizontal grid (ItemsLayout=&quot;HorizontalGrid, 2&quot;), the header and footer views sit at the start and end of the rows. Scroll sideways to reach the footer." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource ListSurface}"
                VerticalOptions="Start">
            <CollectionView ItemsSource="{Binding Monkeys}"
                            ItemsLayout="HorizontalGrid, 2"
                            HeightRequest="128">
                <CollectionView.Header>
                    <Grid Padding="20,0"
                          Background="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}">
                        <VerticalStackLayout Spacing="6"
                                             VerticalOptions="Center">
                            <Image Source="monkey_face.png"
                                   HeightRequest="32"
                                   WidthRequest="32" />
                            <Label Text="Monkeys"
                                   Style="{StaticResource Headline}"
                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.Header>
                <CollectionView.Footer>
                    <Grid Padding="16,0"
                          WidthRequest="150"
                          Background="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}">
                        <VerticalStackLayout Spacing="6"
                                             VerticalOptions="Center">
                            <Image Source="dotnet_bot.png"
                                   HeightRequest="32"
                                   WidthRequest="52" />
                            <Label Text="Friends of Xamarin Monkey"
                                   Style="{StaticResource Caption}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Monkey">
                        <Grid Padding="12,8"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="48,140"
                              ColumnSpacing="12">
                            <Image Grid.RowSpan="2"
                                   Source="{Binding ImageUrl}"
                                   HeightRequest="48"
                                   WidthRequest="48" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   Style="{StaticResource Headline}"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="End" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Location}"
                                   Style="{StaticResource Caption}"
                                   LineBreakMode="TailTruncation" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
