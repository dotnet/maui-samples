<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CollectionViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CollectionViewDemos.ViewModels"
             x:Class="CollectionViewDemos.Views.VerticalListGroupingPage"
             Title="Grouped list"
             x:DataType="viewmodels:GroupedAnimalsViewModel">
    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Grouping" Style="{StaticResource Eyebrow}" />
            <Label Text="Grouped list" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="IsGrouped=&quot;True&quot; shows each group of animals with a GroupHeaderTemplate and a GroupFooterTemplate." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource ListSurface}">
            <CollectionView ItemsSource="{Binding Animals}"
                            IsGrouped="true">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Animal">
                        <Grid Padding="16,10"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">
                            <Image Grid.RowSpan="2"
                                   Source="{Binding ImageUrl}"
                                   HeightRequest="48"
                                   WidthRequest="48" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   Style="{StaticResource Headline}"
                                   VerticalOptions="End" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Location}"
                                   Style="{StaticResource Caption}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="models:AnimalGroup">
                        <Label Text="{Binding Name}"
                               Style="{StaticResource GroupHeader}" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.GroupFooterTemplate>
                    <DataTemplate x:DataType="models:AnimalGroup">
                        <Label Text="{Binding Count, StringFormat='Total animals: {0:D}'}"
                               Style="{StaticResource Caption}"
                               Padding="16,4,16,12" />
                    </DataTemplate>
                </CollectionView.GroupFooterTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
