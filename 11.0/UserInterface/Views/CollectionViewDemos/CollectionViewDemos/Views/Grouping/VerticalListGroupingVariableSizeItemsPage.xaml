<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CollectionViewDemos.Controls"
             xmlns:models="clr-namespace:CollectionViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CollectionViewDemos.ViewModels"
             x:Class="CollectionViewDemos.Views.VerticalListGroupingVariableSizeItemsPage"
             Title="Grouped variable size items"
             x:DataType="viewmodels:GroupedAnimalsViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Grouping" Style="{StaticResource Eyebrow}" />
            <Label Text="Grouped variable size items" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Each animal's description makes its item a different height. Choose MeasureFirstItem to size every item like the first one." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="6">
                <Label Text="ItemSizingStrategy"
                       Style="{StaticResource Caption}" />
                <controls:EnumPicker x:Name="enumPicker"
                                     EnumType="{x:Type ItemSizingStrategy}"
                                     SelectedIndex="0" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource ListSurface}">
            <CollectionView ItemsSource="{Binding Animals}"
                            IsGrouped="true"
                            ItemSizingStrategy="{Binding x:DataType='controls:EnumPicker', Source={x:Reference enumPicker}, Path=SelectedItem}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Animal">
                        <Grid Padding="16,10"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="14"
                              RowSpacing="4">
                            <Image Grid.RowSpan="2"
                                   Source="{Binding ImageUrl}"
                                   HeightRequest="48"
                                   WidthRequest="48" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   Style="{StaticResource Headline}"
                                   VerticalOptions="End" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Location}"
                                   Style="{StaticResource Caption}" />
                            <!-- The description's length varies, so each item has a different height. -->
                            <Label Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding Details}"
                                   Style="{StaticResource BodySecondary}"
                                   FontSize="14" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="models:AnimalGroup">
                        <Label Text="{Binding Name}"
                               Style="{StaticResource GroupHeader}" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.GroupFooterTemplate>
                    <DataTemplate x:DataType="models:AnimalGroup">
                        <Label Text="{Binding Count, StringFormat='Total animals: {0:D}'}"
                               Style="{StaticResource Caption}"
                               Padding="16,4,16,12" />
                    </DataTemplate>
                </CollectionView.GroupFooterTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
