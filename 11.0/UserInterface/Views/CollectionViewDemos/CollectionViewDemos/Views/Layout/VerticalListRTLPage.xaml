<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CollectionViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CollectionViewDemos.ViewModels"
             x:Class="CollectionViewDemos.Views.VerticalListRTLPage"
             Title="Right-to-left"
             FlowDirection="RightToLeft"
             x:DataType="viewmodels:MonkeysViewModel">
    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Layout" Style="{StaticResource Eyebrow}" />
            <Label Text="Right-to-left" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="FlowDirection=&quot;RightToLeft&quot; on the page mirrors the list and every item in it." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource ListSurface}">
            <CollectionView ItemsSource="{Binding Monkeys}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Monkey">
                        <Grid Padding="16,10"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">
                            <Image Grid.RowSpan="2"
                                   Source="{Binding ImageUrl}"
                                   HeightRequest="48"
                                   WidthRequest="48" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   Style="{StaticResource Headline}"
                                   VerticalOptions="End" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Location}"
                                   Style="{StaticResource Caption}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
