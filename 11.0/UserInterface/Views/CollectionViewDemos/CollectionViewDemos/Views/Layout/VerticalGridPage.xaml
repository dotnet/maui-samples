<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CollectionViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CollectionViewDemos.ViewModels"
             x:Class="CollectionViewDemos.Views.VerticalGridPage"
             Title="Vertical grid"
             x:DataType="viewmodels:MonkeysViewModel">
    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Layout" Style="{StaticResource Eyebrow}" />
            <Label Text="Vertical grid" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="ItemsLayout=&quot;VerticalGrid, 2&quot; shows the template in two columns, here as a stacked tile." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource ListSurface}">
            <CollectionView ItemsSource="{Binding Monkeys}"
                            ItemsLayout="VerticalGrid, 2">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Monkey">
                        <Grid Padding="12"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="2">
                            <Image Source="{Binding ImageUrl}"
                                   HeightRequest="56"
                                   WidthRequest="56" />
                            <Label Grid.Row="1"
                                   Text="{Binding Name}"
                                   Style="{StaticResource Headline}"
                                   FontSize="15"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation" />
                            <Label Grid.Row="2"
                                   Text="{Binding Location}"
                                   Style="{StaticResource Caption}"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
