<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CollectionViewDemos.Controls"
             xmlns:models="clr-namespace:CollectionViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CollectionViewDemos.ViewModels"
             x:Class="CollectionViewDemos.Views.HorizontalGridSpacingPage"
             Title="Horizontal grid spacing"
             x:DataType="viewmodels:MonkeysViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Spacing" Style="{StaticResource Eyebrow}" />
            <Label Text="Horizontal grid spacing" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="In a horizontal grid, VerticalItemSpacing separates rows and HorizontalItemSpacing separates columns. Enter both, such as &quot;10,20&quot;, and tap Update." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <!-- Declared before the SpacingModifier so Android doesn't focus its Entry and open the keyboard on launch.
             The height fits four 64-high rows plus room for the vertical spacing you enter. -->
        <Border Grid.Row="2"
                Style="{StaticResource ListSurface}"
                Padding="8"
                VerticalOptions="Start">
            <CollectionView x:Name="collectionView"
                            ItemsSource="{Binding Monkeys}"
                            ItemsLayout="HorizontalGrid, 4"
                            HeightRequest="320">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Monkey">
                        <!-- Tinted tiles make the space between items easy to see. -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Background="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}">
                            <Grid Padding="12,8"
                                  RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="48,140"
                                  ColumnSpacing="12">
                                <Image Grid.RowSpan="2"
                                       Source="{Binding ImageUrl}"
                                       HeightRequest="48"
                                       WidthRequest="48" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       Style="{StaticResource Headline}"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="End" />
                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding Location}"
                                       Style="{StaticResource Caption}"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <controls:SpacingModifier Grid.Row="1"
                                  CV="{x:Reference collectionView}"
                                  SpacingText="0,0" />
    </Grid>
</ContentPage>
