<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CollectionViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CollectionViewDemos.ViewModels"
             x:Class="CollectionViewDemos.Views.VerticalListSingleSelectionPage"
             Title="Single selection"
             x:DataType="viewmodels:MonkeysViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Selection" Style="{StaticResource Eyebrow}" />
            <Label Text="Single selection" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="SelectionMode=&quot;Single&quot; selects one item at a time, and the SelectionChanged event reports the previous and current selection. Select a monkey." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource Card}">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="12"
                  RowSpacing="6">
                <Label Text="Previous selected item:"
                       Style="{StaticResource BodySecondary}" />
                <Label x:Name="previousSelectedItemLabel"
                       Grid.Column="1"
                       Style="{StaticResource Headline}" />
                <Label Grid.Row="1"
                       Text="Current selected item:"
                       Style="{StaticResource BodySecondary}" />
                <Label x:Name="currentSelectedItemLabel"
                       Grid.Row="1"
                       Grid.Column="1"
                       Style="{StaticResource Headline}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource ListSurface}">
            <CollectionView ItemsSource="{Binding Monkeys}"
                            SelectionMode="Single"
                            SelectionChanged="OnCollectionViewSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Monkey">
                        <Grid Style="{StaticResource SelectableItem}"
                              Padding="16,10"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">
                            <Image Grid.RowSpan="2"
                                   Source="{Binding ImageUrl}"
                                   HeightRequest="48"
                                   WidthRequest="48" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   Style="{StaticResource Headline}"
                                   VerticalOptions="End" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Location}"
                                   Style="{StaticResource Caption}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
