<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CollectionViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CollectionViewDemos.ViewModels"
             x:Class="CollectionViewDemos.Views.VerticalListMultipleSelectionPage"
             Title="Multiple selection"
             x:DataType="viewmodels:MonkeysViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Selection" Style="{StaticResource Eyebrow}" />
            <Label Text="Multiple selection" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="SelectionMode=&quot;Multiple&quot; lets you select several items. Tap monkeys to select them, and tap again to deselect." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource Card}">
            <!-- The selection lists can get long, so they scroll instead of pushing the list down. -->
            <ScrollView MaximumHeightRequest="120">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Previous selected item:"
                           Style="{StaticResource Caption}" />
                    <Label x:Name="previousSelectedItemLabel"
                           Style="{StaticResource Body}" />
                    <Label Text="Current selected item:"
                           Style="{StaticResource Caption}"
                           Margin="0,8,0,0" />
                    <Label x:Name="currentSelectedItemLabel"
                           Style="{StaticResource Headline}" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource ListSurface}">
            <CollectionView ItemsSource="{Binding Monkeys}"
                            SelectionMode="Multiple"
                            SelectionChanged="OnCollectionViewSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Monkey">
                        <Grid Style="{StaticResource SelectableItem}"
                              Padding="16,10"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">
                            <Image Grid.RowSpan="2"
                                   Source="{Binding ImageUrl}"
                                   HeightRequest="48"
                                   WidthRequest="48" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   Style="{StaticResource Headline}"
                                   VerticalOptions="End" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Location}"
                                   Style="{StaticResource Caption}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
