<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CollectionViewDemos.ViewModels"
             x:Class="CollectionViewDemos.Views.EmptyViewNullPage"
             Title="Null ItemsSource"
             x:DataType="viewmodels:MonkeysViewModel">
    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Empty view" Style="{StaticResource Eyebrow}" />
            <Label Text="Null ItemsSource" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="ItemsSource is null, so the CollectionView shows the string set as its EmptyView." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}">
            <CollectionView ItemsSource="{Binding EmptyMonkeys}"
                            EmptyView="No items to display" />
        </Border>
    </Grid>
</ContentPage>
