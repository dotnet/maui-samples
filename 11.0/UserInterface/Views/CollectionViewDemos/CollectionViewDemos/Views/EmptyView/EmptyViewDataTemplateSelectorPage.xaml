<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CollectionViewDemos"
             xmlns:controls="clr-namespace:CollectionViewDemos.Controls"
             xmlns:models="clr-namespace:CollectionViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CollectionViewDemos.ViewModels"
             x:Class="CollectionViewDemos.Views.EmptyViewDataTemplateSelectorPage"
             Title="EmptyView template selector"
             x:DataType="viewmodels:MonkeysViewModel">
    <ContentPage.Resources>
        <DataTemplate x:Key="AdvancedTemplate">
            <VerticalStackLayout Padding="24,48"
                                 Spacing="6"
                                 VerticalOptions="Center">
                <Label Text="{x:Static local:MaterialIcons.SearchOff}"
                       Style="{StaticResource Icon}"
                       FontSize="40"
                       TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                       Margin="0,0,0,6" />
                <Label Text="No results matched your filter."
                       Style="{StaticResource Headline}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Try a broader filter?"
                       Style="{StaticResource Caption}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="BasicTemplate">
            <VerticalStackLayout Padding="24,48"
                                 Spacing="6"
                                 VerticalOptions="Center">
                <Label Text="{x:Static local:MaterialIcons.Inbox}"
                       Style="{StaticResource Icon}"
                       FontSize="40"
                       TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                       Margin="0,0,0,6" />
                <Label Text="No items to display."
                       Style="{StaticResource Headline}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </DataTemplate>

        <controls:SearchTermDataTemplateSelector x:Key="SearchSelector"
                                                 DefaultTemplate="{StaticResource AdvancedTemplate}"
                                                 OtherTemplate="{StaticResource BasicTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Empty view" Style="{StaticResource Eyebrow}" />
            <Label Text="EmptyView template selector" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="A DataTemplateSelector picks the EmptyViewTemplate from the filter text. Search for &quot;xamarin&quot;, then for another term that matches no monkeys." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <!-- Declared before the SearchBar so Android doesn't focus the SearchBar and open the keyboard on launch. -->
        <Border Grid.Row="2"
                Style="{StaticResource ListSurface}">
            <CollectionView ItemsSource="{Binding Monkeys}"
                            EmptyView="{Binding x:DataType='SearchBar', Source={x:Reference searchBar}, Path=Text}"
                            EmptyViewTemplate="{StaticResource SearchSelector}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Monkey">
                        <Grid Padding="16,10"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">
                            <Image Grid.RowSpan="2"
                                   Source="{Binding ImageUrl}"
                                   HeightRequest="48"
                                   WidthRequest="48" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   Style="{StaticResource Headline}"
                                   VerticalOptions="End" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Location}"
                                   Style="{StaticResource Caption}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <SearchBar x:Name="searchBar"
                   Grid.Row="1"
                   SearchCommand="{Binding FilterCommand}"
                   SearchCommandParameter="{Binding x:DataType='SearchBar', Source={x:Reference searchBar}, Path=Text}"
                   Placeholder="Filter" />
    </Grid>
</ContentPage>
