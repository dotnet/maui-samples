<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CarouselViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CarouselViewDemos.ViewModels"
             x:Class="CarouselViewDemos.Views.CurrentItemAndPositionBindingsPage"
             Title="Current item and position bindings"
             x:DataType="viewmodels:MonkeysViewModel">
    <ContentPage.BindingContext>
        <viewmodels:MonkeysViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Interaction" Style="{StaticResource Eyebrow}" />
            <Label Text="Current item and position bindings" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="CurrentItemChangedCommand and PositionChangedCommand update the view model. The labels bind to it." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,*"
                      RowSpacing="12"
                      ColumnSpacing="12">
                    <VerticalStackLayout
                                         Spacing="2">
                        <Label Text="Previous item"
                               Style="{StaticResource Caption}" />
                        <Label Text="{Binding PreviousMonkey.Name, FallbackValue='None', TargetNullValue='None'}"
                               Style="{StaticResource Headline}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2">
                        <Label Text="Current item"
                               Style="{StaticResource Caption}" />
                        <Label Text="{Binding CurrentMonkey.Name, FallbackValue='None', TargetNullValue='None'}"
                               Style="{StaticResource Headline}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1"
                                         Spacing="2">
                        <Label Text="Previous position"
                               Style="{StaticResource Caption}" />
                        <Label Text="{Binding PreviousPosition}"
                               Style="{StaticResource Headline}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                                         Spacing="2">
                        <Label Text="Current position"
                               Style="{StaticResource Caption}" />
                        <Label Text="{Binding CurrentPosition}"
                               Style="{StaticResource Headline}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <CarouselView Grid.Row="2"
                      ItemsSource="{Binding Monkeys}"
                      CurrentItemChangedCommand="{Binding ItemChangedCommand}"
                      CurrentItemChangedCommandParameter="{Binding x:DataType='CarouselView', Source={RelativeSource Self}, Path=CurrentItem}"
                      PositionChangedCommand="{Binding PositionChangedCommand}"
                      PositionChangedCommandParameter="{Binding x:DataType='CarouselView', Source={RelativeSource Self}, Path=Position}">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:Monkey">
                    <Grid>
                        <Border Style="{StaticResource ItemCard}"
                                HeightRequest="360"
                                VerticalOptions="Start">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource Title2}"
                                       HorizontalTextAlignment="Center" />
                                <Image Source="{Binding ImageUrl}"
                                       HeightRequest="150"
                                       WidthRequest="150" />
                                <Label Text="{Binding Location}"
                                       Style="{StaticResource Caption}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Details}"
                                       Style="{StaticResource BodySecondary}"
                                       HorizontalTextAlignment="Center"
                                       MaxLines="3"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
    </Grid>
</ContentPage>
