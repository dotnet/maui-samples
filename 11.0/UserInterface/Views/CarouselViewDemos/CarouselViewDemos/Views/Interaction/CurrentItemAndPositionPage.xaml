<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CarouselViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CarouselViewDemos.ViewModels"
             x:Class="CarouselViewDemos.Views.CurrentItemAndPositionPage"
             Title="Current item and position"
             x:DataType="viewmodels:MonkeysViewModel">
    <ContentPage.BindingContext>
        <viewmodels:MonkeysViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Interaction" Style="{StaticResource Eyebrow}" />
            <Label Text="Current item and position" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="The CurrentItemChanged and PositionChanged events update the labels. Swipe to another monkey." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,*"
                      RowSpacing="12"
                      ColumnSpacing="12">
                    <VerticalStackLayout
                                         Spacing="2">
                        <Label Text="Previous item"
                               Style="{StaticResource Caption}" />
                        <Label x:Name="previousItemLabel"
                               Style="{StaticResource Headline}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2">
                        <Label Text="Current item"
                               Style="{StaticResource Caption}" />
                        <Label x:Name="currentItemLabel"
                               Style="{StaticResource Headline}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1"
                                         Spacing="2">
                        <Label Text="Previous item position"
                               Style="{StaticResource Caption}" />
                        <Label x:Name="previousItemPositionLabel"
                               Style="{StaticResource Headline}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                                         Spacing="2">
                        <Label Text="Current item position"
                               Style="{StaticResource Caption}" />
                        <Label x:Name="currentItemPositionLabel"
                               Style="{StaticResource Headline}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <CarouselView Grid.Row="2"
                      ItemsSource="{Binding Monkeys}"
                      CurrentItemChanged="OnCurrentItemChanged"
                      PositionChanged="OnPositionChanged">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:Monkey">
                    <Grid>
                        <Border Style="{StaticResource ItemCard}"
                                HeightRequest="360"
                                VerticalOptions="Start">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource Title2}"
                                       HorizontalTextAlignment="Center" />
                                <Image Source="{Binding ImageUrl}"
                                       HeightRequest="150"
                                       WidthRequest="150" />
                                <Label Text="{Binding Location}"
                                       Style="{StaticResource Caption}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Details}"
                                       Style="{StaticResource BodySecondary}"
                                       HorizontalTextAlignment="Center"
                                       MaxLines="3"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
    </Grid>
</ContentPage>
