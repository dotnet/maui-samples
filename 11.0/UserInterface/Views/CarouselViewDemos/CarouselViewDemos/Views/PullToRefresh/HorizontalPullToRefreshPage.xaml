<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CarouselViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CarouselViewDemos.ViewModels"
             x:Class="CarouselViewDemos.Views.HorizontalPullToRefreshPage"
             Title="Refresh a horizontal carousel"
             x:DataType="viewmodels:AnimalsViewModel">
    <ContentPage.BindingContext>
        <viewmodels:AnimalsViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Pull to refresh" Style="{StaticResource Eyebrow}" />
            <Label Text="Refresh a horizontal carousel" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="A RefreshView wraps the carousel. Pull a card down to refresh, and ten more animals are added." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource Hint}">
            <Label Text="{Binding Animals.Count, StringFormat='Number of items: {0}'}"
                   Style="{StaticResource HintLabel}" />
        </Border>

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CarouselView ItemsSource="{Binding Animals}">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="models:Animal">
                        <Grid>
                            <Border Style="{StaticResource ItemCard}"
                                    HeightRequest="360"
                                    VerticalOptions="Start">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource Title2}"
                                           HorizontalTextAlignment="Center" />
                                    <Image Source="{Binding ImageUrl}"
                                           HeightRequest="150"
                                           WidthRequest="150" />
                                    <Label Text="{Binding Location}"
                                           Style="{StaticResource Caption}"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding Details}"
                                           Style="{StaticResource BodySecondary}"
                                           HorizontalTextAlignment="Center"
                                           MaxLines="3"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
        </RefreshView>
    </Grid>
</ContentPage>
