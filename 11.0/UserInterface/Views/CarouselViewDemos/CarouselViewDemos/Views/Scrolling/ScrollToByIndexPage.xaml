<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CarouselViewDemos.Controls"
             xmlns:models="clr-namespace:CarouselViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CarouselViewDemos.ViewModels"
             x:Class="CarouselViewDemos.Views.ScrollToByIndexPage"
             Title="Scroll to an index"
             x:DataType="viewmodels:MonkeysViewModel">
    <ContentPage.BindingContext>
        <viewmodels:MonkeysViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Scrolling" Style="{StaticResource Eyebrow}" />
            <Label Text="Scroll to an index" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="ScrollTo(6) moves the carousel to the seventh monkey, Japanese Macaque." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <CarouselView Grid.Row="2"
                      x:Name="carouselView"
                      ItemsSource="{Binding Monkeys}"
                      Scrolled="OnCarouselViewScrolled">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:Monkey">
                    <Grid>
                        <Border Style="{StaticResource ItemCard}"
                                HeightRequest="360"
                                VerticalOptions="Start">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource Title2}"
                                       HorizontalTextAlignment="Center" />
                                <Image Source="{Binding ImageUrl}"
                                       HeightRequest="150"
                                       WidthRequest="150" />
                                <Label Text="{Binding Location}"
                                       Style="{StaticResource Caption}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Details}"
                                       Style="{StaticResource BodySecondary}"
                                       HorizontalTextAlignment="Center"
                                       MaxLines="3"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <Border Grid.Row="1"
                Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <Label Text="ScrollToPosition"
                           Style="{StaticResource Body}"
                           VerticalOptions="Center" />
                    <controls:EnumPicker x:Name="enumPicker"
                                         Grid.Column="1"
                                         EnumType="{x:Type ScrollToPosition}"
                                         SelectedIndex="0"
                                         WidthRequest="150" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <Label Text="Animate scroll"
                           Style="{StaticResource Body}"
                           VerticalOptions="Center" />
                    <Switch x:Name="animateSwitch"
                            Grid.Column="1"
                            IsToggled="true"
                            VerticalOptions="Center" />
                </Grid>
                <Button Text="Scroll to item 6"
                        Clicked="OnButtonClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
