<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CarouselViewDemos.Controls"
             xmlns:models="clr-namespace:CarouselViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CarouselViewDemos.ViewModels"
             x:Class="CarouselViewDemos.Views.HorizontalLayoutDataTemplateSelectorPage"
             Title="DataTemplateSelector"
             x:DataType="viewmodels:MonkeysViewModel">
    <ContentPage.BindingContext>
        <viewmodels:MonkeysViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <DataTemplate x:Key="AmericanMonkeyTemplate"
                      x:DataType="models:Monkey">
            <Grid>
                <Border Style="{StaticResource ItemCard}"
                        HeightRequest="360"
                        VerticalOptions="Start">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Name}"
                               Style="{StaticResource Title2}"
                               HorizontalTextAlignment="Center" />
                        <Image Source="{Binding ImageUrl}"
                               HeightRequest="150"
                               WidthRequest="150" />
                        <Label Text="{Binding Location}"
                               Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Details}"
                               Style="{StaticResource BodySecondary}"
                               HorizontalTextAlignment="Center"
                               MaxLines="3"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="OtherMonkeyTemplate"
                      x:DataType="models:Monkey">
            <Grid>
                <Border Style="{StaticResource ItemCard}"
                        HeightRequest="360"
                        VerticalOptions="Start">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Name}"
                               Style="{StaticResource Title2}"
                               TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                               HorizontalTextAlignment="Center" />
                        <Image Source="{Binding ImageUrl}"
                               Opacity="0.5"
                               HeightRequest="150"
                               WidthRequest="150" />
                        <Label Text="{Binding Location}"
                               Style="{StaticResource Caption}"
                               TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Details}"
                               Style="{StaticResource BodySecondary}"
                               TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                               HorizontalTextAlignment="Center"
                               MaxLines="3"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </DataTemplate>
        <controls:MonkeyDataTemplateSelector x:Key="MonkeySelector"
                                             AmericanMonkey="{StaticResource AmericanMonkeyTemplate}"
                                             OtherMonkey="{StaticResource OtherMonkeyTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Layout" Style="{StaticResource Eyebrow}" />
            <Label Text="DataTemplateSelector" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="MonkeyDataTemplateSelector gives monkeys from the Americas the full card and all others a muted one." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <CarouselView Grid.Row="1"
                      ItemsSource="{Binding Monkeys}"
                      ItemTemplate="{StaticResource MonkeySelector}" />
    </Grid>
</ContentPage>
