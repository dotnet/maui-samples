<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CarouselViewDemos"
             xmlns:controls="clr-namespace:CarouselViewDemos.Controls"
             xmlns:models="clr-namespace:CarouselViewDemos.Models"
             xmlns:viewmodels="clr-namespace:CarouselViewDemos.ViewModels"
             x:Class="CarouselViewDemos.Views.EmptyViewDataTemplateSelectorPage"
             Title="EmptyView template selector"
             x:DataType="viewmodels:MonkeysViewModel">
    <ContentPage.BindingContext>
        <viewmodels:MonkeysViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <DataTemplate x:Key="AdvancedTemplate">
            <VerticalStackLayout Padding="24,48"
                                 Spacing="6">
                <Label Text="{x:Static local:MaterialIcons.SearchOff}"
                       Style="{StaticResource Icon}"
                       FontSize="40"
                       TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                       Margin="0,0,0,6" />
                <Label Text="No results matched your filter."
                       Style="{StaticResource Headline}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Try a broader filter?"
                       Style="{StaticResource Caption}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="BasicTemplate">
            <VerticalStackLayout Padding="24,48"
                                 Spacing="6">
                <Label Text="{x:Static local:MaterialIcons.Inbox}"
                       Style="{StaticResource Icon}"
                       FontSize="40"
                       TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                       Margin="0,0,0,6" />
                <Label Text="No items to display."
                       Style="{StaticResource Headline}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </DataTemplate>
        <controls:SearchTermDataTemplateSelector x:Key="SearchSelector"
                                                 DefaultTemplate="{StaticResource AdvancedTemplate}"
                                                 OtherTemplate="{StaticResource BasicTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Empty view" Style="{StaticResource Eyebrow}" />
            <Label Text="EmptyView template selector" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="SearchTermDataTemplateSelector picks the EmptyViewTemplate from the filter term. Try &quot;xamarin&quot;, then any other name." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <!-- Declared before the SearchBar so Android doesn't focus the SearchBar and open the keyboard on launch. -->
        <CarouselView Grid.Row="2"
                      ItemsSource="{Binding Monkeys}"
                      EmptyView="{Binding x:DataType='SearchBar', Source={x:Reference searchBar}, Path=Text}"
                      EmptyViewTemplate="{StaticResource SearchSelector}">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:Monkey">
                    <Grid>
                        <Border Style="{StaticResource ItemCard}"
                                HeightRequest="360"
                                VerticalOptions="Start">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource Title2}"
                                       HorizontalTextAlignment="Center" />
                                <Image Source="{Binding ImageUrl}"
                                       HeightRequest="150"
                                       WidthRequest="150" />
                                <Label Text="{Binding Location}"
                                       Style="{StaticResource Caption}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Details}"
                                       Style="{StaticResource BodySecondary}"
                                       HorizontalTextAlignment="Center"
                                       MaxLines="3"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <SearchBar Grid.Row="1" x:Name="searchBar"
                   SearchCommand="{Binding FilterCommand}"
                   SearchCommandParameter="{Binding x:DataType='SearchBar', Source={RelativeSource Self}, Path=Text}"
                   Placeholder="Filter" />
    </Grid>
</ContentPage>
