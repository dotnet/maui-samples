<?xml version="1.0" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:SwipeGesture" x:Class="SwipeGesture.SwipeContainerPage">
    <Grid Margin="20" RowSpacing="6" RowDefinitions="Auto,*,Auto">
        <Label Text="Swipe inside the box with a single finger." Grid.Row="0"/>
        <local:SwipeContainer Swipe="OnSwiped" HorizontalOptions="Center" VerticalOptions="Center" Grid.Row="1">
            <BoxView Color="Teal" WidthRequest="300" HeightRequest="300"/>
        </local:SwipeContainer>
        <Label x:Name="_label" Text="You swiped: " Grid.Row="2"/>
    </Grid>
</ContentPage>
