<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Gallery design system: color tokens.

    Semantic tokens come in Light/Dark pairs. Styles.xaml combines each pair with
    AppThemeBinding, so pages normally use a style instead of a color directly.
    The accent palette is shared by both themes and is used for category tints and
    for the colors shown inside the demos (shapes, swatches, and so on).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="PrimaryLight">#512BD4</Color>
    <Color x:Key="PrimaryDark">#A893FF</Color>
    <Color x:Key="PrimaryPressedLight">#3E1DB0</Color>
    <Color x:Key="PrimaryPressedDark">#C2B3FF</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#1B0C52</Color>
    <Color x:Key="PrimaryContainerLight">#ECE7FF</Color>
    <Color x:Key="PrimaryContainerDark">#2D2363</Color>
    <Color x:Key="OnPrimaryContainerLight">#2A1077</Color>
    <Color x:Key="OnPrimaryContainerDark">#E5DEFF</Color>

    <!-- Surfaces -->
    <Color x:Key="BackgroundLight">#F6F5FA</Color>
    <Color x:Key="BackgroundDark">#0F0E14</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1D1B27</Color>
    <Color x:Key="SurfaceVariantLight">#EFEDF6</Color>
    <Color x:Key="SurfaceVariantDark">#24222F</Color>
    <Color x:Key="OutlineLight">#E3E0EC</Color>
    <Color x:Key="OutlineDark">#353146</Color>
    <Color x:Key="OutlineStrongLight">#948EA8</Color>
    <Color x:Key="OutlineStrongDark">#6E6982</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryLight">#17151F</Color>
    <Color x:Key="TextPrimaryDark">#F4F2FA</Color>
    <Color x:Key="TextSecondaryLight">#5B5670</Color>
    <Color x:Key="TextSecondaryDark">#ADA8BF</Color>
    <Color x:Key="TextTertiaryLight">#6B6682</Color>
    <Color x:Key="TextTertiaryDark">#8C879F</Color>
    <Color x:Key="TextDisabledLight">#B3AEC2</Color>
    <Color x:Key="TextDisabledDark">#5A566B</Color>

    <!-- Accent palette for fills, strokes, and icons on both light and dark surfaces.
         Each has at least 3:1 contrast with white (except Amber), so they work as icon
         tiles. For white body text on a fill, use the Deep variants below. -->
    <Color x:Key="Violet">#7C5CFF</Color>
    <Color x:Key="Blue">#3B82F6</Color>
    <Color x:Key="Sky">#0284C7</Color>
    <Color x:Key="Teal">#0D9488</Color>
    <Color x:Key="Green">#16A34A</Color>
    <Color x:Key="Amber">#F59E0B</Color>
    <Color x:Key="Orange">#EA580C</Color>
    <Color x:Key="Rose">#F43F5E</Color>
    <Color x:Key="Pink">#EC4899</Color>

    <!-- Deeper accents for fills that carry white text (at least 4.5:1 contrast) -->
    <Color x:Key="DeepViolet">#5B21B6</Color>
    <Color x:Key="DeepBlue">#1D4ED8</Color>
    <Color x:Key="DeepTeal">#0F766E</Color>
    <Color x:Key="DeepRose">#BE123C</Color>
    <Color x:Key="DeepPink">#BE185D</Color>

    <!-- Hero gradient -->
    <Color x:Key="HeroStart">#4521C2</Color>
    <Color x:Key="HeroMiddle">#6E3FF3</Color>
    <Color x:Key="HeroEnd">#2563EB</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

</ResourceDictionary>
