<?xml version="1.0" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ControlGallery.Views.XAML.AbsoluteLayoutDemoPage" Title="AbsoluteLayout Demo">
    <Grid RowSpacing="6" RowDefinitions="Auto,*">
        <Label Text="AbsoluteLayout" FontSize="40" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0"/>

        <AbsoluteLayout BackgroundColor="#CCCCFF" VerticalOptions="Fill" Grid.Row="1">
            
            <!-- Create two Labels for animating. -->
            <Label x:Name="text1" Text="AbsoluteLayout" TextColor="Black" AbsoluteLayout.LayoutFlags="PositionProportional"/>
            
            <Label x:Name="text2" Text="AbsoluteLayout" TextColor="Black" AbsoluteLayout.LayoutFlags="PositionProportional"/>
        </AbsoluteLayout>
    </Grid>
</ContentPage>
