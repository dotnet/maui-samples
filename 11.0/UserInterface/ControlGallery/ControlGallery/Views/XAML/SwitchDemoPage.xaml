<?xml version="1.0" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ControlGallery.Views.XAML.SwitchDemoPage" Title="Switch Demo">
    <Grid RowSpacing="6" RowDefinitions="Auto,*,*">
        <Label Text="Switch" FontSize="50" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0"/>

        <Switch x:Name="switch" HorizontalOptions="Center" VerticalOptions="Center" Grid.Row="1"/>

        <Label Text="Switch is now False" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" Grid.Row="2">
            <Label.Triggers>
                <DataTrigger x:DataType="Switch" TargetType="Label" Binding="{Binding Source={x:Reference switch},                                                Path=IsToggled}" Value="True">
                    <Setter Property="Text" Value="Switch is now True"/>
                </DataTrigger>
            </Label.Triggers>
        </Label>
    </Grid>
</ContentPage>
