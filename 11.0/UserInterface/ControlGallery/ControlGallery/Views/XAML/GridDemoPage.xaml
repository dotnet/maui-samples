<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlGallery.Views.XAML.GridDemoPage"
             Title="Grid">
    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Layouts" Style="{StaticResource Eyebrow}" />
            <Label Text="Grid" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Arrange children in rows and columns with auto, star, and fixed sizes." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}"
                Padding="12">
            <Grid RowSpacing="8"
                  ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="100" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <Label Text="Autosized cell"
                       Grid.Column="0" Grid.Row="0"
                       TextColor="White"
                       Background="{StaticResource DeepBlue}"
                       Padding="8" />

                <BoxView Color="{StaticResource Sky}"
                         Grid.Column="1" Grid.Row="0"
                         HeightRequest="0" />

                <BoxView Color="{StaticResource Violet}"
                         Grid.Column="0" Grid.Row="1" />

                <Label Text="Leftover space"
                       Grid.Column="1" Grid.Row="1"
                       TextColor="White"
                       Background="{StaticResource DeepViolet}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />

                <Label Text="Span two rows (or more if you want)"
                       Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                       TextColor="White"
                       Background="{StaticResource DeepTeal}"
                       Padding="8"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />

                <Label Text="Span 2 columns"
                       Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                       TextColor="White"
                       Background="{StaticResource DeepRose}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />

                <Label Text="Fixed 100x100"
                       Grid.Column="2" Grid.Row="2"
                       TextColor="White"
                       Background="{StaticResource DeepPink}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
