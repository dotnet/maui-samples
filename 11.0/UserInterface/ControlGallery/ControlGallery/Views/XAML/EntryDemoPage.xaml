<?xml version="1.0" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ControlGallery.Views.XAML.EntryDemoPage" Title="Entry" Padding="10, 0">
    <Grid RowSpacing="6" RowDefinitions="Auto,*,*,*">
        <Label Text="Entry" FontSize="50" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0"/>

        <Entry Keyboard="Email" Placeholder="Enter email address" VerticalOptions="Center" Grid.Row="1"/>

        <Entry Keyboard="Text" Placeholder="Enter password" IsPassword="True" VerticalOptions="Center" Grid.Row="2"/>

        <Entry Keyboard="Telephone" Placeholder="Enter phone number" VerticalOptions="Center" Grid.Row="3"/>
    </Grid>
</ContentPage>
