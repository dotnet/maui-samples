<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:models="clr-namespace:ControlGallery.Models"
            x:Class="ControlGallery.Views.XAML.FlyoutPageDemoPage"
            Title="FlyoutPage">
    <FlyoutPage.Flyout>
        <ContentPage Title="Color List">
            <Grid RowDefinitions="Auto,*"
                  Style="{StaticResource DemoLayout}"
                  Padding="12,16,12,0"
                  RowSpacing="12">
                <VerticalStackLayout Style="{StaticResource DemoHeader}"
                                     Padding="8,0">
                    <Label Text="Pages" Style="{StaticResource Eyebrow}" />
                    <Label Text="FlyoutPage" Style="{StaticResource Title1}" />
                    <Label Text="Pick a color to show it in the detail page." Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <CollectionView x:Name="collectionView"
                                Grid.Row="1"
                                SelectionMode="Single"
                                SelectionChanged="OnCollectionViewSelectionChanged">
                    <CollectionView.ItemsSource>
                        <x:Array Type="{x:Type models:NamedColor}">
                            <models:NamedColor Name="Aqua" Color="Aqua" />
                            <models:NamedColor Name="Black" Color="Black" />
                            <models:NamedColor Name="Blue" Color="Blue" />
                            <models:NamedColor Name="Fuchsia" Color="Fuchsia" />
                            <models:NamedColor Name="Gray" Color="Gray" />
                            <models:NamedColor Name="Green" Color="Green" />
                            <models:NamedColor Name="Lime" Color="Lime" />
                            <models:NamedColor Name="Maroon" Color="Maroon" />
                            <models:NamedColor Name="Navy" Color="Navy" />
                            <models:NamedColor Name="Olive" Color="Olive" />
                            <models:NamedColor Name="Purple" Color="Purple" />
                            <models:NamedColor Name="Red" Color="Red" />
                            <models:NamedColor Name="Silver" Color="Silver" />
                            <models:NamedColor Name="Teal" Color="Teal" />
                            <models:NamedColor Name="White" Color="White" />
                            <models:NamedColor Name="Yellow" Color="Yellow" />
                        </x:Array>
                    </CollectionView.ItemsSource>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:NamedColor">
                            <Grid Padding="8,10"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light={StaticResource OutlineStrongLight}, Dark={StaticResource OutlineStrongDark}}"
                                        Background="{Binding Color}"
                                        WidthRequest="24"
                                        HeightRequest="24" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </ContentPage>
    </FlyoutPage.Flyout>

    <FlyoutPage.Detail>
        <ContentPage x:DataType="models:NamedColor"
                     Title="{Binding Name}"
                     BindingContext="{Binding x:DataType='CollectionView', Source={x:Reference collectionView}, Path=SelectedItem}">
            <ScrollView>
                <Grid RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="24"
                      Padding="20,24">
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 32"
                            Background="{Binding Color}"
                            HeightRequest="160"
                            WidthRequest="160"
                            HorizontalOptions="Center" />

                    <Border Grid.Row="1"
                            Style="{StaticResource DemoSurface}">
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="RGB" Style="{StaticResource Eyebrow}" />
                                <Label Text="{Binding Red, StringFormat='R = {0:F2}'}" />
                                <Label Text="{Binding Green, StringFormat='G = {0:F2}'}" />
                                <Label Text="{Binding Blue, StringFormat='B = {0:F2}'}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="6">
                                <Label Text="HSL" Style="{StaticResource Eyebrow}" />
                                <Label Text="{Binding Hue, StringFormat='Hue = {0:F2}'}" />
                                <Label Text="{Binding Saturation, StringFormat='Saturation = {0:F2}'}" />
                                <Label Text="{Binding Luminosity, StringFormat='Luminosity = {0:F2}'}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- On phones the flyout is hidden; this opens it. -->
                    <Button Grid.Row="2"
                            Text="Choose a color"
                            Style="{StaticResource TonalButton}"
                            Clicked="OnShowFlyoutClicked" />
                </Grid>
            </ScrollView>
        </ContentPage>
    </FlyoutPage.Detail>
</FlyoutPage>
