<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlGallery.Views.XAML.LabelDemoPage"
             Title="Label">
    <Grid RowDefinitions="Auto,Auto"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Display" Style="{StaticResource Eyebrow}" />
            <Label Text="Label" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Display single or multi-line text." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}">
            <Label Text=".NET Multi-platform App UI (.NET MAUI) is a cross-platform, natively backed UI toolkit that allows developers to easily create user interfaces that can be shared across Android, iOS, macOS, and Windows."
                   FontSize="20"
                   LineHeight="1.3" />
        </Border>
    </Grid>
</ContentPage>
