<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlGallery.Views.XAML.ContentViewDemoPage"
             Title="ContentView">
    <Grid RowDefinitions="Auto,Auto"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Layouts" Style="{StaticResource Eyebrow}" />
            <Label Text="ContentView" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Host a single child. Useful for adding padding or a background, or as a base for custom controls." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}">
            <ContentView Background="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}"
                         Padding="24">
                <Label Text="This ContentView (tinted in this example) has a single child, this Label. ContentView doesn't do much else, but it's a convenient way to give its child a background color or some padding."
                       TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}" />
            </ContentView>
        </Border>
    </Grid>
</ContentPage>
