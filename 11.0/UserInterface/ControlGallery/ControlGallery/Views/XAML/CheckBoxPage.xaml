<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlGallery.Views.XAML.CheckBoxPage"
             Title="CheckBox">
    <Grid RowDefinitions="Auto,Auto"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Input" Style="{StaticResource Eyebrow}" />
            <Label Text="CheckBox" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Select a Boolean value." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}">
            <VerticalStackLayout Spacing="12"
                                 VerticalOptions="Center">
                <CheckBox x:Name="checkbox"
                          HorizontalOptions="Center" />
                <Label Text="CheckBox is now False"
                       Style="{StaticResource Value}">
                    <Label.Triggers>
                        <DataTrigger x:DataType="CheckBox"
                                     TargetType="Label"
                                     Binding="{Binding Source={x:Reference checkbox}, Path=IsChecked}"
                                     Value="True">
                            <Setter Property="Text" Value="CheckBox is now True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
