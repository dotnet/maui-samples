<?xml version="1.0" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:models="clr-namespace:ControlGallery.Models" xmlns:views="clr-namespace:ControlGallery.Views.XAML" x:Class="ControlGallery.Views.XAML.CarouselViewDemoPage" Title="CarouselView Demo" x:DataType="views:CarouselViewDemoPage">
    <StackLayout Margin="20">
        <Label Text="CarouselView" FontSize="50" FontAttributes="Bold" HorizontalOptions="Center"/>
        <CarouselView ItemsSource="{Binding Monkeys}">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:Monkey">
                    <Grid RowSpacing="6" RowDefinitions="*">
                        <Border Stroke="DarkGray" StrokeShape="RoundRectangle 5" Margin="20" Padding="20" HeightRequest="300" HorizontalOptions="Center" VerticalOptions="Center" Grid.Row="0">
                            <StackLayout>
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="150" WidthRequest="150" HorizontalOptions="Center"/>
                                <Label Text="{Binding Location}" HorizontalOptions="Center"/>
                                <Label Text="{Binding Details}" FontAttributes="Italic" HorizontalOptions="Center" MaxLines="5" LineBreakMode="TailTruncation"/>
                            </StackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
    </StackLayout>
</ContentPage>
