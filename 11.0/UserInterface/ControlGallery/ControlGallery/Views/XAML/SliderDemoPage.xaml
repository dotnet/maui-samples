<?xml version="1.0" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ControlGallery.Views.XAML.SliderDemoPage" Title="Slider Demo">
    <Grid RowSpacing="6" RowDefinitions="Auto,*,*">
        <Label Text="Slider" FontSize="50" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0"/>
        
        <Slider x:Name="slider" Minimum="0" Maximum="100" VerticalOptions="Center" Grid.Row="1"/>

        <Label x:DataType="Slider" Text="{Binding Source={x:Reference slider},                               Path=Value,                               StringFormat='Slider value is {0:F1}'}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" Grid.Row="2"/>
    </Grid>
</ContentPage>
