<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlGallery.Views.XAML.DatePickerDemoPage"
             Title="DatePicker">
    <Grid RowDefinitions="Auto,Auto"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Input" Style="{StaticResource Eyebrow}" />
            <Label Text="DatePicker" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Select a date." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}">
            <VerticalStackLayout Spacing="4"
                                 VerticalOptions="Center">
                <Label Text="Date"
                       Style="{StaticResource Caption}" />
                <DatePicker Format="D" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
