<?xml version="1.0" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ControlGallery.Views.XAML.SearchBarDemoPage" Title="SearchBar Demo" Padding="10, 0">
    <Grid RowSpacing="6" RowDefinitions="Auto,Auto,*">
        <Label Text="SearchBar" FontSize="50" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0"/>

        <SearchBar Placeholder=".NET MAUI property" SearchButtonPressed="OnSearchBarButtonPressed" Grid.Row="1"/>

        <ScrollView VerticalOptions="Fill" Grid.Row="2">
            <Label x:Name="resultsLabel"/>
        </ScrollView>
    </Grid>
</ContentPage>
