<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlGallery.Views.XAML.VerticalStackLayoutDemoPage"
             Title="VerticalStackLayout">
    <Grid RowDefinitions="Auto,Auto"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Layouts" Style="{StaticResource Eyebrow}" />
            <Label Text="VerticalStackLayout" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Arrange children in a single vertical column." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Primary colors"
                       Style="{StaticResource SectionHeader}" />
                <Rectangle Fill="{StaticResource Rose}"
                           HeightRequest="30" />
                <Rectangle Fill="{StaticResource Amber}"
                           HeightRequest="30" />
                <Rectangle Fill="{StaticResource Blue}"
                           HeightRequest="30" />
                <Label Text="Secondary colors"
                       Style="{StaticResource SectionHeader}"
                       Margin="0,10,0,0" />
                <Rectangle Fill="{StaticResource Green}"
                           HeightRequest="30" />
                <Rectangle Fill="{StaticResource Orange}"
                           HeightRequest="30" />
                <Rectangle Fill="{StaticResource Violet}"
                           HeightRequest="30" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
