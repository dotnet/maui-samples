<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlGallery.Views.XAML.RectangleDemoPage"
             Title="Rectangle">
    <Grid RowDefinitions="Auto,Auto"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Shapes &amp; graphics" Style="{StaticResource Eyebrow}" />
            <Label Text="Rectangle" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Draw a rectangle or square, optionally with rounded corners." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}">
            <VerticalStackLayout Spacing="24"
                                 VerticalOptions="Center">
                <Rectangle Fill="{StaticResource Violet}"
                           WidthRequest="150"
                           HeightRequest="50"
                           HorizontalOptions="Center" />
                <Rectangle Stroke="{StaticResource Amber}"
                           StrokeThickness="4"
                           RadiusX="24"
                           RadiusY="24"
                           WidthRequest="150"
                           HeightRequest="150"
                           HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
