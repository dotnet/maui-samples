<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlGallery.Views.XAML.ActivityIndicatorDemoPage"
             Title="ActivityIndicator">
    <Grid RowDefinitions="Auto,Auto"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Display" Style="{StaticResource Eyebrow}" />
            <Label Text="ActivityIndicator" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Show that the app is busy." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}">
            <VerticalStackLayout Spacing="20"
                                 VerticalOptions="Center">
                <ActivityIndicator x:DataType="Switch"
                                   IsRunning="{Binding Source={x:Reference runningSwitch}, Path=IsToggled}"
                                   HorizontalOptions="Center" />
                <HorizontalStackLayout Spacing="12"
                                       HorizontalOptions="Center">
                    <Label Text="IsRunning"
                           VerticalOptions="Center" />
                    <Switch x:Name="runningSwitch"
                            IsToggled="True"
                            SemanticProperties.Description="Run the activity indicator" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
