<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlGallery.Views.XAML.StepperDemoPage"
             Title="Stepper">
    <Grid RowDefinitions="Auto,Auto"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Input" Style="{StaticResource Eyebrow}" />
            <Label Text="Stepper" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Select a number from discrete increments." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}">
            <VerticalStackLayout Spacing="16"
                                 VerticalOptions="Center">
                <Stepper x:Name="stepper"
                         Minimum="0"
                         Maximum="10"
                         Increment="0.1"
                         HorizontalOptions="Center" />
                <Label x:DataType="Stepper"
                       Text="{Binding Source={x:Reference stepper}, Path=Value, StringFormat='Stepper value is {0:F1}'}"
                       Style="{StaticResource Value}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
