<?xml version="1.0" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ControlGallery.Views.XAML.StepperDemoPage" Title="Stepper Demo">
    <Grid RowSpacing="6" RowDefinitions="Auto,*,*">
        <Label Text="Stepper" FontSize="50" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0"/>

        <Stepper x:Name="stepper" Minimum="0" Maximum="10" Increment="0.1" HorizontalOptions="Center" VerticalOptions="Center" Grid.Row="1"/>

        <Label x:DataType="Stepper" Text="{Binding Source={x:Reference stepper},                               Path=Value,                               StringFormat='Stepper value is {0:F1}'}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" Grid.Row="2"/>
    </Grid>
</ContentPage>
