<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ControlGallery.Models"
             xmlns:views="clr-namespace:ControlGallery.Views.XAML"
             x:Class="ControlGallery.Views.XAML.IndicatorViewDemoPage"
             Title="IndicatorView"
             x:DataType="views:IndicatorViewDemoPage">
    <Grid RowDefinitions="Auto,Auto,Auto"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Collections" Style="{StaticResource Eyebrow}" />
            <Label Text="IndicatorView" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Show the number of items in a CarouselView, and the current position." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <CarouselView Grid.Row="1"
                      ItemsSource="{Binding Animals}"
                      IndicatorView="indicatorView"
                      HeightRequest="440"
                      PeekAreaInsets="28"
                      Margin="-20,0">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:Animal">
                    <Border Style="{StaticResource Card}"
                            Padding="0"
                            Margin="6,0"
                            VerticalOptions="Start">
                        <Grid RowDefinitions="200,Auto">
                            <Grid Style="{StaticResource ArtworkBackdrop}">
                                <Image Source="{Binding Image}"
                                       HeightRequest="128"
                                       WidthRequest="128"
                                       AutomationProperties.IsInAccessibleTree="False" />
                            </Grid>
                            <VerticalStackLayout Grid.Row="1"
                                                 Padding="20"
                                                 Spacing="6">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource Title2}" />
                                <Label Text="{Binding Location}"
                                       Style="{StaticResource Eyebrow}" />
                                <Label Text="{Binding Details}"
                                       Style="{StaticResource BodySecondary}"
                                       MaxLines="5"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView x:Name="indicatorView"
                       Grid.Row="2"
                       IndicatorSize="8"
                       MaximumVisible="12"
                       HorizontalOptions="Center" />
    </Grid>
</ContentPage>
