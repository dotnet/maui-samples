<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlGallery.Views.XAML.ProgressBarDemoPage"
             Title="ProgressBar">
    <Grid RowDefinitions="Auto,Auto"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Display" Style="{StaticResource Eyebrow}" />
            <Label Text="ProgressBar" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Show the progress of a task. This one is advanced by a timer." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}">
            <VerticalStackLayout Spacing="16"
                                 VerticalOptions="Center">
                <ProgressBar x:Name="progressBar" />
                <Label x:DataType="ProgressBar"
                       Text="{Binding Source={x:Reference progressBar}, Path=Progress, StringFormat='{0:P0} complete'}"
                       Style="{StaticResource Value}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
