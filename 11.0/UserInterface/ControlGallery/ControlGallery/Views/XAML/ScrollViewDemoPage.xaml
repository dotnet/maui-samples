<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlGallery.Views.XAML.ScrollViewDemoPage"
             Title="ScrollView">
    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource DemoLayout}">
        <VerticalStackLayout Style="{StaticResource DemoHeader}">
            <Label Text="Layouts" Style="{StaticResource Eyebrow}" />
            <Label Text="ScrollView" Style="{StaticResource Title1}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Scroll content that is too large to fit on the page." Style="{StaticResource Lead}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource DemoSurface}"
                Padding="20,0">
            <ScrollView>
                <Label Text="Sometimes page content fits entirely on the page. That's very convenient. But on many occasions, the content of the page is much too large for the page, or only becomes available at runtime. &#10;&#10;For cases such as these, the ScrollView provides a solution. Simply set its Content property to your content — in this case a Label but in the general case very likely a Layout derivative with multiple children — and the ScrollView provides scrolling with the distinctive look and touch familiar to the user. &#10;&#10;The ScrollView is also capable of horizontal scrolling, and while that's usually not as common as vertical scrolling, sometimes it comes in handy. &#10;&#10;Most often, the content of a ScrollView is a StackLayout. Whenever you're using a StackLayout with a number of items determined only at runtime, you should probably put it in a ScrollView just to be sure your stuff doesn't go running off the bottom of the screen."
                       FontSize="20"
                       LineHeight="1.3"
                       Padding="0,20" />
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
