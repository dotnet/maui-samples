<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:XamlSamples"
             x:Class="XamlSamples.MainPage"
             x:DataType="local:MainPage"
             Title="XAML fundamentals"
             NavigationPage.HasNavigationBar="False"
             ControlTemplate="{x:Null}"
             SafeAreaEdges="Container">

    <!-- 17 pages, so a BindableLayout in a ScrollView is enough: nothing needs to be virtualized. -->
    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,24">
            <Grid x:Name="hero"
                  Padding="20,12,20,0">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        Padding="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="{StaticResource HeroStart}" Offset="0" />
                            <GradientStop Color="{StaticResource HeroMiddle}" Offset="0.55" />
                            <GradientStop Color="{StaticResource HeroEnd}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Decorative circles -->
                        <Ellipse Fill="#1AFFFFFF"
                                 WidthRequest="240"
                                 HeightRequest="240"
                                 HorizontalOptions="End"
                                 VerticalOptions="Start"
                                 Margin="0,-110,-80,0" />
                        <Ellipse Fill="#12FFFFFF"
                                 WidthRequest="160"
                                 HeightRequest="160"
                                 HorizontalOptions="Start"
                                 VerticalOptions="End"
                                 Margin="-60,0,0,-90" />

                        <Grid Padding="22,16,18,18"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="4"
                              ColumnSpacing="0">
                            <Border Background="#26FFFFFF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,4"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Label Text=".NET MAUI"
                                       FontFamily="InterSemiBold"
                                       FontSize="12"
                                       CharacterSpacing="0.6"
                                       TextColor="White" />
                            </Border>
                            <Image Grid.Column="1"
                                   Source="dotnet_bot.png"
                                   HeightRequest="64"
                                   Aspect="AspectFit"
                                   SemanticProperties.Description="The .NET bots riding a rocket" />
                            <Label Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="XAML fundamentals"
                                   Style="{StaticResource Title1}"
                                   TextColor="White"
                                   SemanticProperties.HeadingLevel="Level1" />
                            <Label Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Text="The pages from the XAML fundamentals tutorial, in order, followed by what's new in .NET 11."
                                   Style="{StaticResource Body}"
                                   TextColor="#E6FFFFFF" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:PageSection">
                        <VerticalStackLayout>
                            <Grid Padding="24,24,24,10"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10">
                                <Ellipse Fill="{Binding AccentBrush}"
                                         WidthRequest="8"
                                         HeightRequest="8"
                                         VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       Style="{StaticResource SectionHeader}"
                                       SemanticProperties.HeadingLevel="Level2" />
                            </Grid>

                            <Border Style="{StaticResource Hint}"
                                    Margin="20,0,20,10"
                                    IsVisible="{Binding HasNote}">
                                <Label Text="{Binding Note}"
                                       Style="{StaticResource HintLabel}" />
                            </Border>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pages}"
                                                 Padding="20,0"
                                                 Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:PageDataViewModel">
                                        <Border Style="{StaticResource Card}"
                                                SemanticProperties.Description="{Binding Title}"
                                                SemanticProperties.Hint="{Binding Description}">
                                            <Border.GestureRecognizers>
                                                <!-- Compiled in .NET 11: RelativeSource AncestorType bindings no longer use reflection. -->
                                                <TapGestureRecognizer Command="{Binding NavigateCommand, Source={RelativeSource AncestorType={x:Type local:MainPage}}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="14"
                                                  RowSpacing="0">
                                                <Border Style="{StaticResource IconTile}"
                                                        Background="{Binding Section.AccentBrush}">
                                                    <Label Text="{Binding Glyph}"
                                                           Style="{StaticResource Icon}"
                                                           FontSize="22"
                                                           TextColor="White" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1"
                                                                     Spacing="2"
                                                                     VerticalOptions="Center">
                                                    <Label Text="{Binding Title}"
                                                           Style="{StaticResource Headline}"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Description}"
                                                           Style="{StaticResource Caption}"
                                                           MaxLines="2"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2"
                                                       Text="{x:Static local:MaterialIcons.ChevronRight}"
                                                       Style="{StaticResource Icon}"
                                                       FontSize="22"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
