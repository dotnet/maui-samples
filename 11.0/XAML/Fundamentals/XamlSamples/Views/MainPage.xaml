<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:local="clr-namespace:XamlSamples"
             x:Class="XamlSamples.MainPage"
			 Padding="5,0"
			 Title="XAML Samples">
	<CollectionView ItemsSource="{x:Static local:PageDataViewModel.All}"
			  SelectionMode="Single" SelectionChanged="OnCollectionViewSelectionChanged">
		<CollectionView.ItemTemplate>
			<DataTemplate x:DataType="local:PageDataViewModel">
				<VerticalStackLayout Padding="10" Spacing="4">
					<Label Text="{Binding Title}" FontAttributes="Bold" />
					<Label Text="{Binding Description}" />
				</VerticalStackLayout>
			</DataTemplate>
		</CollectionView.ItemTemplate>
	</CollectionView>
</ContentPage>