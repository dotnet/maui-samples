<?xml version="1.0" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:models="clr-namespace:TodoSQLite.Models" x:Class="TodoSQLite.Views.TodoItemPage" Title="{Binding Name}" x:DataType="models:TodoItem">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10" VerticalOptions="Start">
            <Label Text="Name"/>
            <Entry Text="{Binding Name}"/>
            <Label Text="Notes"/>
            <Entry Text="{Binding Notes}"/>
            <Label Text="Done"/>
            <Switch IsToggled="{Binding Done}"/>
            <Button Text="Save" Clicked="OnSaveClicked"/>
            <Button Text="Delete" Clicked="OnDeleteClicked"/>
            <Button Text="Cancel" Clicked="OnCancelClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
